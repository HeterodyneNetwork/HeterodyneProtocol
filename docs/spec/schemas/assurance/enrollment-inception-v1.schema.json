{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/assurance/enrollment-inception-v1.schema.json",
  "title": "Heterodyne Assurance enrollment inception v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "spec_version",
    "active_key",
    "created_at",
    "predecessor",
    "cold_root",
    "succession_authority",
    "epoch_policy",
    "witnesses",
    "thresholds",
    "associated_key_policy"
  ],
  "properties": {
    "profile": {
      "const": "heterodyne.assurance.enrollment-inception.v1"
    },
    "spec_version": {
      "const": "heterodyne/0.5.0"
    },
    "active_key": {
      "$ref": "#/definitions/hex32"
    },
    "created_at": {
      "$ref": "#/definitions/unix_time"
    },
    "predecessor": {
      "type": "null"
    },
    "cold_root": {
      "$ref": "#/definitions/hex32"
    },
    "succession_authority": {
      "anyOf": [
        { "$ref": "#/definitions/hex32" },
        { "type": "null" }
      ]
    },
    "epoch_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "current_keys", "next_key_commitments"],
      "properties": {
        "mode": {
          "enum": ["none", "pre-rotation"]
        },
        "current_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/hex32"
          }
        },
        "next_key_commitments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/hex32"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": { "const": "none" }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "current_keys": { "maxItems": 0 },
              "next_key_commitments": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "current_keys": { "minItems": 1 },
              "next_key_commitments": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "witnesses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "weight"],
        "properties": {
          "key": {
            "$ref": "#/definitions/hex32"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch", "witness"],
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "witness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "associated_key_policy": {
      "$ref": "#/definitions/associated_key_policy"
    }
  },
  "definitions": {
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unix_time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "grant_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "scope"],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "associated_key_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_key", "epoch_threshold"],
      "properties": {
        "active_key": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/grant_ceiling" }
        },
        "epoch_threshold": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/grant_ceiling" }
        }
      }
    }
  }
}
