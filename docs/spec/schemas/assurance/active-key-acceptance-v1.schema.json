{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/assurance/active-key-acceptance-v1.schema.json",
  "title": "Heterodyne Assurance active-key acceptance and head v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "spec_version",
    "active_key",
    "created_at",
    "predecessor",
    "inception_event_id",
    "cold_root",
    "cold_root_signature",
    "assurance_head",
    "state"
  ],
  "properties": {
    "profile": {
      "const": "heterodyne.assurance.active-key-acceptance.v1"
    },
    "spec_version": {
      "const": "heterodyne/0.5.0"
    },
    "active_key": {
      "$ref": "#/definitions/hex32"
    },
    "created_at": {
      "$ref": "#/definitions/unix_time"
    },
    "predecessor": {
      "$ref": "#/definitions/hex32"
    },
    "inception_event_id": {
      "$ref": "#/definitions/hex32"
    },
    "cold_root": {
      "$ref": "#/definitions/hex32"
    },
    "cold_root_signature": {
      "$ref": "#/definitions/signature"
    },
    "assurance_head": {
      "$ref": "#/definitions/hex32"
    },
    "state": {
      "enum": ["assured", "downgraded"]
    },
    "downgrade_consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recovery_authority", "signature"],
      "properties": {
        "recovery_authority": {
          "$ref": "#/definitions/hex32"
        },
        "signature": {
          "$ref": "#/definitions/signature"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": { "const": "assured" }
        },
        "required": ["state"]
      },
      "then": {
        "not": {
          "required": ["downgrade_consent"]
        }
      },
      "else": {
        "required": ["downgrade_consent"]
      }
    }
  ],
  "definitions": {
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "unix_time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
