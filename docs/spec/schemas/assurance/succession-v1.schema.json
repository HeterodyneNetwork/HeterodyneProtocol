{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/assurance/succession-v1.schema.json",
  "title": "Heterodyne Assurance active-key succession v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "spec_version",
    "active_key",
    "created_at",
    "predecessor",
    "previous_active_key",
    "previous_head",
    "new_active_key",
    "authorizing_evidence",
    "new_key_acceptance",
    "class",
    "next_succession_authority",
    "next_epoch_policy",
    "witnesses",
    "thresholds",
    "next_associated_key_policy",
    "subordinate_reauthorizations"
  ],
  "properties": {
    "profile": {
      "const": "heterodyne.assurance.succession.v1"
    },
    "spec_version": {
      "const": "heterodyne/0.5.0"
    },
    "active_key": {
      "$ref": "#/definitions/hex32"
    },
    "created_at": {
      "$ref": "#/definitions/unix_time"
    },
    "predecessor": {
      "$ref": "#/definitions/hex32"
    },
    "previous_active_key": {
      "$ref": "#/definitions/hex32"
    },
    "previous_head": {
      "$ref": "#/definitions/hex32"
    },
    "new_active_key": {
      "$ref": "#/definitions/hex32"
    },
    "authorizing_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_class",
        "authority_proofs",
        "witness_receipts"
      ],
      "properties": {
        "authority_class": {
          "enum": ["succession", "recovery", "epoch-threshold"]
        },
        "authority_proofs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["authority_key", "signature"],
            "properties": {
              "authority_key": {
                "$ref": "#/definitions/hex32"
              },
              "signature": {
                "$ref": "#/definitions/signature"
              }
            }
          }
        },
        "witness_receipts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["witness_key", "signature"],
            "properties": {
              "witness_key": {
                "$ref": "#/definitions/hex32"
              },
              "signature": {
                "$ref": "#/definitions/signature"
              }
            }
          }
        }
      }
    },
    "new_key_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "signature"],
      "properties": {
        "key": {
          "$ref": "#/definitions/hex32"
        },
        "signature": {
          "$ref": "#/definitions/signature"
        }
      }
    },
    "class": {
      "enum": ["routine", "compromise"]
    },
    "compromise_time": {
      "$ref": "#/definitions/unix_time"
    },
    "next_succession_authority": {
      "anyOf": [
        { "$ref": "#/definitions/hex32" },
        { "type": "null" }
      ]
    },
    "next_epoch_policy": {
      "$ref": "#/definitions/epoch_policy"
    },
    "witnesses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/witness"
      }
    },
    "thresholds": {
      "$ref": "#/definitions/thresholds"
    },
    "next_associated_key_policy": {
      "$ref": "#/definitions/associated_key_policy"
    },
    "subordinate_reauthorizations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "subject_key", "scope", "expires_at"],
        "properties": {
          "role": {
            "$ref": "#/definitions/name"
          },
          "subject_key": {
            "$ref": "#/definitions/hex32"
          },
          "scope": {
            "$ref": "#/definitions/scope"
          },
          "expires_at": {
            "anyOf": [
              { "$ref": "#/definitions/unix_time" },
              { "type": "null" }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "class": { "const": "compromise" }
        },
        "required": ["class"]
      },
      "then": {
        "required": ["compromise_time"],
        "properties": {
          "authorizing_evidence": {
            "properties": {
              "authority_class": { "const": "recovery" }
            }
          },
          "subordinate_reauthorizations": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "authorizing_evidence": {
            "properties": {
              "authority_class": {
                "enum": ["succession", "epoch-threshold"]
              }
            }
          }
        },
        "not": {
          "required": ["compromise_time"]
        }
      }
    }
  ],
  "definitions": {
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "unix_time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "epoch_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "current_keys", "next_key_commitments"],
      "properties": {
        "mode": {
          "enum": ["none", "pre-rotation"]
        },
        "current_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/hex32"
          }
        },
        "next_key_commitments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/hex32"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": { "const": "none" }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "current_keys": { "maxItems": 0 },
              "next_key_commitments": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "current_keys": { "minItems": 1 },
              "next_key_commitments": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "weight"],
      "properties": {
        "key": {
          "$ref": "#/definitions/hex32"
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch", "witness"],
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "witness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "grant_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "scope"],
      "properties": {
        "role": { "$ref": "#/definitions/name" },
        "scope": { "$ref": "#/definitions/scope" }
      }
    },
    "associated_key_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_key", "epoch_threshold"],
      "properties": {
        "active_key": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/grant_ceiling" }
        },
        "epoch_threshold": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/grant_ceiling" }
        }
      }
    }
  }
}
