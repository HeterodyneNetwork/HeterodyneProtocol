{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/workspace/joint-workspace-relationship-v1.schema.json",
  "title": "joint-workspace-relationship-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "object_type",
    "workspace_key",
    "policy_head",
    "predecessor",
    "authority_checkpoint",
    "repository_rid",
    "repository_head",
    "issued_at",
    "signature",
    "relationship_id",
    "joint_workspace_key",
    "participant_workspace_keys",
    "delegate_keys",
    "threshold",
    "resource_scope",
    "effective_at",
    "expires_at"
  ],
  "properties": {
    "spec_version": {
      "const": "heterodyne/0.5.0"
    },
    "object_type": {
      "const": "joint-workspace-relationship-v1"
    },
    "workspace_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "predecessor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_checkpoint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_rid": {
      "type": "string",
      "pattern": "^rad:[A-Za-z0-9]+$"
    },
    "repository_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "relationship_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "joint_workspace_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "participant_workspace_keys": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "delegate_keys": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "threshold": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "resource_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "effective_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
