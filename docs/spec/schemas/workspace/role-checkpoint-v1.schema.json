{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/workspace/role-checkpoint-v1.schema.json",
  "title": "role-checkpoint-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "object_type",
    "workspace_id",
    "actor",
    "kel_head",
    "authority_sequence",
    "repository_rid",
    "repository_head",
    "issued_at",
    "signature",
    "checkpoint_id",
    "role_id",
    "sequence",
    "materialized_at",
    "workspace_policy_head",
    "role_policy_heads",
    "active_grant_ids",
    "revocation_ids",
    "relationship_ids",
    "host_ids",
    "resource_ids",
    "previous_checkpoint"
  ],
  "properties": {
    "spec_version": {
      "const": "workspace/0.1.0"
    },
    "object_type": {
      "const": "role-checkpoint-v1"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actor": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kel_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "repository_rid": {
      "type": "string",
      "pattern": "^rad:[A-Za-z0-9]+$"
    },
    "repository_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "role_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "materialized_at": {
      "type": "integer",
      "minimum": 0
    },
    "workspace_policy_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "role_policy_heads": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "active_grant_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "revocation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "relationship_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "host_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "previous_checkpoint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
