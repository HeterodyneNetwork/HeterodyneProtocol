{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/workspace/resource-advertisement-v1.schema.json",
  "title": "resource-advertisement-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "object_type",
    "workspace_key",
    "policy_head",
    "predecessor",
    "authority_checkpoint",
    "repository_rid",
    "repository_head",
    "issued_at",
    "signature",
    "resource_id",
    "role_id",
    "resource_type",
    "visibility",
    "locators",
    "required_capabilities",
    "key_epoch",
    "history_mode",
    "selected_snapshots",
    "retention_seconds",
    "host_ids",
    "key_custody_host_ids",
    "repository_owner_key",
    "repository_writer_nids",
    "trusted_seed_nids"
  ],
  "properties": {
    "spec_version": {
      "const": "heterodyne/0.5.0"
    },
    "object_type": {
      "const": "resource-advertisement-v1"
    },
    "workspace_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "predecessor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_checkpoint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_rid": {
      "type": "string",
      "pattern": "^rad:[A-Za-z0-9]+$"
    },
    "repository_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "role_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resource_type": {
      "enum": [
        "project",
        "group",
        "artifact",
        "service",
        "repository"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "selective",
        "private"
      ]
    },
    "locators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "read",
          "write",
          "triage",
          "moderate",
          "admin",
          "invite",
          "govern-policy",
          "govern-subroles",
          "govern-thresholds",
          "govern-publicize",
          "govern-federation",
          "govern-delegation",
          "govern-lifecycle"
        ]
      },
      "uniqueItems": true
    },
    "key_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "history_mode": {
      "enum": [
        "full",
        "from-admission",
        "selected-snapshots"
      ]
    },
    "selected_snapshots": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "retention_seconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "host_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "key_custody_host_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "repository_owner_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_writer_nids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
      },
      "uniqueItems": true
    },
    "trusted_seed_nids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
      },
      "uniqueItems": true
    }
  }
}
