{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/workspace/role-revocation-v1.schema.json",
  "title": "role-revocation-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "object_type",
    "workspace_key",
    "policy_head",
    "predecessor",
    "authority_checkpoint",
    "repository_rid",
    "repository_head",
    "issued_at",
    "signature",
    "revocation_id",
    "target_type",
    "target_id",
    "effective_at",
    "reason"
  ],
  "properties": {
    "spec_version": {
      "const": "heterodyne/0.5.0"
    },
    "object_type": {
      "const": "role-revocation-v1"
    },
    "workspace_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "predecessor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_checkpoint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_rid": {
      "type": "string",
      "pattern": "^rad:[A-Za-z0-9]+$"
    },
    "repository_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "revocation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_type": {
      "enum": [
        "grant",
        "persona",
        "device",
        "relationship",
        "host",
        "resource"
      ]
    },
    "target_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "effective_at": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
