{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heterodyne.network/schemas/social/agent-policy-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "spec_version", "event_id", "device_key", "cold_root", "reason", "observed_at", "evidence", "explanation", "remediation"],
  "properties": {
    "profile": {"const": "heterodyne.social.agent-policy-receipt.v1"},
    "spec_version": {"const": "social/0.5.0"},
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "device_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cold_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason": {"enum": ["agent-attribution-missing", "agent-attribution-falsified", "agent-publication-bypass"]},
    "observed_at": {"type": "integer", "minimum": 0},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "explanation": {"type": "string", "minLength": 1, "maxLength": 4096},
    "remediation": {"const": "rotate-device-key"}
  }
}
