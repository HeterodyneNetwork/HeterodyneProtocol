{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heterodyne.network/schemas/core/persona-profile-v1.schema.json",
  "title": "Heterodyne Core canonical persona profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "cold_root", "publisher", "vanilla_profile", "spec_version"],
  "properties": {
    "profile": { "const": "heterodyne-core-persona-profile-v1" },
    "cold_root": { "$ref": "#/$defs/hex_key" },
    "publisher": { "$ref": "#/$defs/hex_key" },
    "vanilla_profile": {
      "type": "object",
      "additionalProperties": true,
      "required": [],
      "properties": {
        "name": { "type": "string", "maxLength": 256 },
        "display_name": { "type": "string", "maxLength": 256 },
        "about": { "type": "string", "maxLength": 8192 },
        "picture": { "type": "string", "format": "uri", "maxLength": 2048 },
        "banner": { "type": "string", "format": "uri", "maxLength": 2048 },
        "website": { "type": "string", "format": "uri", "maxLength": 2048 },
        "nip05": { "type": "string", "minLength": 3, "maxLength": 320 }
      }
    },
    "spec_version": { "const": "core/0.5.0" }
  },
  "$defs": {
    "hex_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
