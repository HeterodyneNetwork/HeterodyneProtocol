{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heterodyne.network/schemas/core/persona-profile-v1.schema.json",
  "title": "Heterodyne Core kind-0 profile extension v1",
  "description": "An upstream-open Nostr kind-0 content object with one optional, closed Heterodyne discovery extension.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "heterodyne": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": { "$ref": "#/$defs/radicle_rid" },
        "identity_chain": { "$ref": "#/$defs/naddr" },
        "cold_root": { "$ref": "#/$defs/hex_key" },
        "succession_authority": { "$ref": "#/$defs/hex_key" }
      }
    }
  },
  "$defs": {
    "hex_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "radicle_rid": {
      "type": "string",
      "pattern": "^rad:z[1-9A-HJ-NP-Za-km-z]{20,28}$"
    },
    "naddr": {
      "type": "string",
      "minLength": 70,
      "maxLength": 8192,
      "pattern": "^naddr1[023456789acdefghjklmnpqrstuvwxyz]+$"
    }
  }
}
