{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/credential-ledger-removal-observation-v1.schema.json",
  "title": "Heterodyne Comms credential ledger removal observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "persona",
    "transition_id",
    "transition_digest",
    "checkpoint_digest",
    "source_ref_head",
    "staged_ref",
    "staged_head",
    "node_nid",
    "observed_at",
    "signature"
  ],
  "properties": {
    "type": {
      "const": "heterodyne.credential-ledger.removal-observation.v1"
    },
    "persona": {
      "$ref": "#/definitions/sha256"
    },
    "transition_id": {
      "$ref": "#/definitions/id_16"
    },
    "transition_digest": {
      "$ref": "#/definitions/sha256"
    },
    "checkpoint_digest": {
      "$ref": "#/definitions/sha256"
    },
    "source_ref_head": {
      "$ref": "#/definitions/typed_git_object"
    },
    "staged_ref": {
      "$ref": "#/definitions/config_ref"
    },
    "staged_head": {
      "$ref": "#/definitions/typed_git_object"
    },
    "node_nid": {
      "$ref": "#/definitions/nid"
    },
    "observed_at": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "signature": {
      "$ref": "#/definitions/ed25519_signature"
    }
  },
  "definitions": {
    "id_16": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "json_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nid": {
      "type": "string",
      "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]+$",
      "maxLength": 128
    },
    "ed25519_signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    },
    "config_ref": {
      "type": "string",
      "pattern": "^refs/heads/enc/[0-9a-f]{32}$"
    },
    "git_sha1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_format",
        "oid"
      ],
      "properties": {
        "object_format": {
          "const": "sha1"
        },
        "oid": {
          "$ref": "#/definitions/sha1"
        }
      }
    },
    "git_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_format",
        "oid"
      ],
      "properties": {
        "object_format": {
          "const": "sha256"
        },
        "oid": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "typed_git_object": {
      "oneOf": [
        {
          "$ref": "#/definitions/git_sha1"
        },
        {
          "$ref": "#/definitions/git_sha256"
        }
      ]
    }
  }
}
