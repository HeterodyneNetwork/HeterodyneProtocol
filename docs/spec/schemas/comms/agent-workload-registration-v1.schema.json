{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heterodyne.network/schemas/comms/agent-workload-registration-v1.schema.json",
  "title": "Heterodyne agent workload registration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "persona_key",
    "client_id",
    "subject_jkt",
    "subject_proof",
    "agent_class",
    "selected_signer",
    "signer_key_class",
    "audience",
    "scopes",
    "allowed_kinds",
    "allowed_feeds",
    "allowed_resources",
    "max_content_bytes",
    "rate_limit",
    "not_before",
    "expires_at"
  ],
  "properties": {
    "persona_key": {
      "$ref": "#/$defs/nostr_key"
    },
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "subject_jkt": {
      "$ref": "#/$defs/jwk_thumbprint"
    },
    "subject_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "jkt"],
      "properties": {
        "method": {
          "const": "dpop"
        },
        "jkt": {
          "$ref": "#/$defs/jwk_thumbprint"
        }
      }
    },
    "agent_class": {
      "enum": ["ai", "programmatic"]
    },
    "selected_signer": {
      "$ref": "#/$defs/nostr_key"
    },
    "signer_key_class": {
      "enum": ["agent", "persona"]
    },
    "agent_association": {
      "$ref": "#/$defs/agent_association"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "allowed_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      }
    },
    "allowed_feeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "allowed_resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "max_content_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_seconds", "count", "burst"],
      "properties": {
        "window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "burst": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "not_before": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1
    },
    "software_claim_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "signer_key_class": {
            "const": "persona"
          }
        },
        "required": ["signer_key_class"]
      },
      "then": {
        "properties": {
          "scopes": {
            "contains": {
              "const": "heterodyne:agent:sign:persona"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "agent_association": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "key" },
            "value": { "$ref": "#/$defs/nostr_key" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "role" },
            "value": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      ]
    },
    "nostr_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "jwk_thumbprint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  }
}
