{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heterodyne.network/schemas/comms/agent-workload-registration-v1.schema.json",
  "title": "Heterodyne agent workload registration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_id",
    "subject_jkt",
    "agent_class",
    "role_id",
    "audience",
    "scopes",
    "allowed_kinds",
    "allowed_feeds",
    "allowed_resources",
    "max_content_bytes",
    "rate_limit",
    "not_before",
    "expires_at"
  ],
  "properties": {
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "subject_jkt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "agent_class": {
      "enum": ["ai", "programmatic"]
    },
    "role_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "allowed_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      }
    },
    "allowed_feeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "allowed_resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "max_content_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_seconds", "count", "burst"],
      "properties": {
        "window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "burst": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "not_before": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1
    },
    "software_claim_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
