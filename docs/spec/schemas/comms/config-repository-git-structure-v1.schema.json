{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/config-repository-git-structure-v1.schema.json",
  "title": "Heterodyne config repository raw Git structure carrier v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "object_format",
    "commit_oid",
    "commit_raw_base64url",
    "tree_objects"
  ],
  "properties": {
    "type": { "const": "heterodyne.config-repository-git-structure.v1" },
    "object_format": { "enum": ["sha1", "sha256"] },
    "commit_oid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "commit_raw_base64url": { "$ref": "#/definitions/base64url_nonempty" },
    "tree_objects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/tree_object" }
    }
  },
  "oneOf": [
    {
      "properties": {
        "object_format": { "const": "sha1" },
        "commit_oid": { "$ref": "#/definitions/hex40" },
        "tree_objects": {
          "items": {
            "allOf": [
              { "$ref": "#/definitions/tree_object" },
              {
                "properties": {
                  "oid": { "$ref": "#/definitions/hex40" }
                }
              }
            ]
          }
        }
      },
      "required": ["object_format", "commit_oid", "tree_objects"]
    },
    {
      "properties": {
        "object_format": { "const": "sha256" },
        "commit_oid": { "$ref": "#/definitions/hex64" },
        "tree_objects": {
          "items": {
            "allOf": [
              { "$ref": "#/definitions/tree_object" },
              {
                "properties": {
                  "oid": { "$ref": "#/definitions/hex64" }
                }
              }
            ]
          }
        }
      },
      "required": ["object_format", "commit_oid", "tree_objects"]
    }
  ],
  "definitions": {
    "hex40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base64url_nonempty": {
      "type": "string",
      "minLength": 2,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
    },
    "tree_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oid", "raw_base64url"],
      "properties": {
        "oid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "raw_base64url": { "$ref": "#/definitions/base64url_nonempty" }
      }
    }
  }
}
