{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/node-secret-exposure-v1.schema.json",
  "title": "Heterodyne node secret exposure v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "persona",
    "assignment_id",
    "action",
    "holder_nid",
    "secret_class",
    "secret_id",
    "secret_commitment",
    "source_profile",
    "source_record_digest",
    "transition_id",
    "supersedes",
    "issued_at",
    "authority",
    "signature"
  ],
  "properties": {
    "type": { "const": "heterodyne.node-secret-exposure.v1" },
    "persona": { "$ref": "#/definitions/hex64" },
    "assignment_id": { "$ref": "#/definitions/hex32" },
    "action": { "enum": ["assign", "retire"] },
    "holder_nid": { "$ref": "#/definitions/canonical_nid" },
    "secret_class": { "$ref": "#/definitions/secret_class" },
    "secret_id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{32}|[0-9a-f]{64})$"
    },
    "secret_commitment": { "$ref": "#/definitions/hex64" },
    "source_profile": { "const": "comms.node-secret-source.v1" },
    "source_record_digest": { "$ref": "#/definitions/hex64" },
    "transition_id": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/definitions/hex32" }
      ]
    },
    "supersedes": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/definitions/hex64" }
      ]
    },
    "issued_at": { "$ref": "#/definitions/json_safe_integer" },
    "authority": { "$ref": "#/definitions/authority" },
    "signature": { "$ref": "#/definitions/hex128" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "secret_class": { "const": "config-audience" } },
        "required": ["secret_class"]
      },
      "then": {
        "properties": { "secret_id": { "$ref": "#/definitions/hex32" } }
      },
      "else": {
        "properties": { "secret_id": { "$ref": "#/definitions/hex64" } }
      }
    },
    {
      "if": {
        "properties": { "action": { "const": "assign" } },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "supersedes": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "transition_id": { "$ref": "#/definitions/hex32" },
          "supersedes": { "$ref": "#/definitions/hex64" }
        }
      }
    }
  ],
  "definitions": {
    "secret_class": {
      "enum": [
        "cold-root",
        "epoch",
        "device-signing",
        "agent-signing",
        "core-protected",
        "config-audience",
        "tier3-audience",
        "claim-ledger-audience",
        "object-dek",
        "double-ratchet",
        "radicle-access",
        "oauth-signing",
        "oauth-pairwise",
        "bearer-credential",
        "ssh-client",
        "ssh-host",
        "recovery-wrap",
        "onion-service-identity",
        "tls-serving"
      ]
    },
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hex128": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "json_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "canonical_nid": {
      "type": "string",
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "kel_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "seq"],
      "properties": {
        "event_id": { "$ref": "#/definitions/hex64" },
        "seq": { "$ref": "#/definitions/json_safe_integer" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer_type", "signer", "kel_head"],
      "properties": {
        "signer_type": { "enum": ["epoch", "cold-root"] },
        "signer": { "$ref": "#/definitions/hex64" },
        "kel_head": { "$ref": "#/definitions/kel_head" }
      }
    }
  }
}
