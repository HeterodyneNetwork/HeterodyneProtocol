{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/credential-ledger-lost-generation-path-v1.schema.json",
  "title": "Heterodyne credential-ledger lost-generation path index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "persona",
    "prior_generation",
    "path_sha256",
    "logical_path",
    "variants"
  ],
  "properties": {
    "type": { "const": "heterodyne.credential-ledger.lost-generation-path.v1" },
    "persona": { "$ref": "#/definitions/hex64" },
    "prior_generation": { "$ref": "#/definitions/json_safe_integer" },
    "path_sha256": { "$ref": "#/definitions/hex64" },
    "logical_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/variant" }
    }
  },
  "definitions": {
    "hex40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "json_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "typed_git_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_format", "oid"],
      "properties": {
        "object_format": { "enum": ["sha1", "sha256"] },
        "oid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "oneOf": [
        {
          "properties": {
            "object_format": { "const": "sha1" },
            "oid": { "$ref": "#/definitions/hex40" }
          }
        },
        {
          "properties": {
            "object_format": { "const": "sha256" },
            "oid": { "$ref": "#/definitions/hex64" }
          }
        }
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_heads",
        "state",
        "storage_object_id",
        "content_sha256",
        "content_path"
      ],
      "properties": {
        "origin_heads": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/typed_git_object" }
        },
        "state": { "enum": ["deleted", "present"] },
        "storage_object_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/typed_git_object" }
          ]
        },
        "content_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/hex64" }
          ]
        },
        "content_path": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^credential-sync/lost-generation-data/(0|[1-9][0-9]*)/[0-9a-f]{64}/(?:sha1-[0-9a-f]{40}|sha256-[0-9a-f]{64})\\.bin$"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "deleted" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "storage_object_id": { "type": "null" },
              "content_sha256": { "type": "null" },
              "content_path": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "storage_object_id": { "$ref": "#/definitions/typed_git_object" },
              "content_sha256": { "$ref": "#/definitions/hex64" },
              "content_path": {
                "type": "string",
                "pattern": "^credential-sync/lost-generation-data/(0|[1-9][0-9]*)/[0-9a-f]{64}/(?:sha1-[0-9a-f]{40}|sha256-[0-9a-f]{64})\\.bin$"
              }
            }
          }
        }
      ]
    }
  }
}
