{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/repository-retention-inventory-v1.schema.json",
  "title": "Heterodyne Comms repository retention inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "persona",
    "inventory_sequence",
    "previous_records",
    "basis_checkpoint_digest",
    "target_generation",
    "target_sequence",
    "repository_refs",
    "issued_at",
    "epoch_pubkey",
    "kel_head",
    "epoch_signature"
  ],
  "properties": {
    "type": {
      "const": "heterodyne.repository-retention-inventory.v1"
    },
    "persona": {
      "$ref": "#/definitions/sha256"
    },
    "inventory_sequence": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "previous_records": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/inventory_parent"
      }
    },
    "basis_checkpoint_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/sha256"
        }
      ]
    },
    "target_generation": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "target_sequence": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "repository_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/repository_ref"
      }
    },
    "issued_at": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "epoch_pubkey": {
      "$ref": "#/definitions/sha256"
    },
    "kel_head": {
      "$ref": "#/definitions/kel_head"
    },
    "epoch_signature": {
      "$ref": "#/definitions/bip340_signature"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "inventory_sequence": {
            "const": 0
          }
        },
        "required": [
          "inventory_sequence"
        ]
      },
      "then": {
        "properties": {
          "previous_records": {
            "maxItems": 0
          },
          "basis_checkpoint_digest": {
            "type": "null"
          },
          "target_generation": {
            "const": 0
          },
          "target_sequence": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "inventory_sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "previous_records": {
            "minItems": 1
          },
          "basis_checkpoint_digest": {
            "$ref": "#/definitions/sha256"
          }
        }
      }
    }
  ],
  "definitions": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bip340_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "json_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "repository_rid": {
      "type": "string",
      "pattern": "^rad:z[1-9A-HJ-NP-Za-km-z]+$",
      "maxLength": 128
    },
    "ref_name": {
      "type": "string",
      "pattern": "^refs/[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9_-])?$",
      "maxLength": 1024
    },
    "git_sha1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_format",
        "oid"
      ],
      "properties": {
        "object_format": {
          "const": "sha1"
        },
        "oid": {
          "$ref": "#/definitions/sha1"
        }
      }
    },
    "git_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_format",
        "oid"
      ],
      "properties": {
        "object_format": {
          "const": "sha256"
        },
        "oid": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "typed_git_object": {
      "oneOf": [
        {
          "$ref": "#/definitions/git_sha1"
        },
        {
          "$ref": "#/definitions/git_sha256"
        }
      ]
    },
    "kel_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "seq"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/definitions/sha256"
        },
        "seq": {
          "$ref": "#/definitions/json_safe_integer"
        }
      }
    },
    "inventory_parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_sequence",
        "record_digest"
      ],
      "properties": {
        "inventory_sequence": {
          "$ref": "#/definitions/json_safe_integer"
        },
        "record_digest": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "repository_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_ref_id",
        "repository_class",
        "repository_rid",
        "ref_name",
        "object_format",
        "retired",
        "scan_head"
      ],
      "properties": {
        "repository_ref_id": {
          "$ref": "#/definitions/sha256"
        },
        "repository_class": {
          "enum": [
            "config",
            "private",
            "public"
          ]
        },
        "repository_rid": {
          "$ref": "#/definitions/repository_rid"
        },
        "ref_name": {
          "$ref": "#/definitions/ref_name"
        },
        "object_format": {
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "retired": {
          "type": "boolean"
        },
        "scan_head": {
          "$ref": "#/definitions/typed_git_object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "object_format": {
                "const": "sha1"
              }
            },
            "required": [
              "object_format"
            ]
          },
          "then": {
            "properties": {
              "scan_head": {
                "$ref": "#/definitions/git_sha1"
              }
            }
          },
          "else": {
            "properties": {
              "scan_head": {
                "$ref": "#/definitions/git_sha256"
              }
            }
          }
        }
      ]
    }
  }
}
