{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/node-secret-transition-action-v1.schema.json",
  "title": "Heterodyne node secret transition action v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "persona",
    "transition_id",
    "action_kind",
    "secret_class",
    "secret_id",
    "old_commitment",
    "disposition",
    "successor_id",
    "successor_commitment",
    "excluded_nids",
    "authorized_nids",
    "source_assignment_digests",
    "pre_unseal_intent_items",
    "retirement_record_digests",
    "successor_assignment_digests",
    "historical_decrypt_nids",
    "historical_assignment_digests",
    "artifact_refs",
    "created_at",
    "authority",
    "signature"
  ],
  "properties": {
    "type": { "const": "heterodyne.node-secret-transition-action.v1" },
    "persona": { "$ref": "#/definitions/hex64" },
    "transition_id": { "$ref": "#/definitions/hex32" },
    "action_kind": {
      "enum": [
        "persona-migration",
        "kel-rotation",
        "delegation-revocation",
        "wrapper-replacement",
        "audience-key-rotation",
        "object-key-replacement",
        "repository-access-revocation",
        "credential-revocation",
        "endpoint-identity-replacement"
      ]
    },
    "secret_class": { "$ref": "#/definitions/secret_class" },
    "secret_id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{32}|[0-9a-f]{64})$"
    },
    "old_commitment": { "$ref": "#/definitions/hex64" },
    "disposition": {
      "enum": [
        "rotate",
        "terminate",
        "revoke-reissue",
        "retire",
        "persona-migration-required"
      ]
    },
    "successor_id": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{32}|[0-9a-f]{64})$"
        }
      ]
    },
    "successor_commitment": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/definitions/hex64" }
      ]
    },
    "excluded_nids": { "$ref": "#/definitions/nid_array" },
    "authorized_nids": { "$ref": "#/definitions/nid_array" },
    "source_assignment_digests": { "$ref": "#/definitions/digest_array" },
    "pre_unseal_intent_items": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/pre_unseal_intent_item" }
    },
    "retirement_record_digests": { "$ref": "#/definitions/digest_array" },
    "successor_assignment_digests": { "$ref": "#/definitions/digest_array" },
    "historical_decrypt_nids": { "$ref": "#/definitions/nid_array" },
    "historical_assignment_digests": { "$ref": "#/definitions/digest_array" },
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/artifact_ref" }
    },
    "created_at": { "$ref": "#/definitions/json_safe_integer" },
    "authority": { "$ref": "#/definitions/authority" },
    "signature": { "$ref": "#/definitions/hex128" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "secret_class": { "const": "config-audience" } },
        "required": ["secret_class"]
      },
      "then": {
        "properties": {
          "secret_id": { "$ref": "#/definitions/hex32" },
          "successor_id": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/definitions/hex32" }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "secret_id": { "$ref": "#/definitions/hex64" },
          "successor_id": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/definitions/hex64" }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": { "enum": ["rotate", "revoke-reissue"] }
        },
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "successor_id": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{32}|[0-9a-f]{64})$"
          },
          "successor_commitment": { "$ref": "#/definitions/hex64" },
          "successor_assignment_digests": { "minItems": 1 }
        }
      },
      "else": {
        "properties": {
          "successor_id": { "type": "null" },
          "successor_commitment": { "type": "null" },
          "successor_assignment_digests": { "maxItems": 0 }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "secret_class": { "const": "cold-root" },
            "action_kind": { "const": "persona-migration" },
            "disposition": { "const": "persona-migration-required" }
          },
          "required": ["secret_class", "action_kind", "disposition"]
        },
        {
          "properties": {
            "secret_class": { "const": "epoch" },
            "action_kind": { "const": "kel-rotation" },
            "disposition": { "const": "rotate" }
          },
          "required": ["secret_class", "action_kind", "disposition"]
        },
        {
          "properties": {
            "secret_class": { "enum": ["device-signing", "agent-signing"] },
            "action_kind": { "const": "delegation-revocation" },
            "disposition": { "enum": ["revoke-reissue", "retire"] }
          },
          "required": ["secret_class", "action_kind", "disposition"]
        },
        {
          "properties": {
            "secret_class": { "enum": ["core-protected", "recovery-wrap"] },
            "action_kind": { "const": "wrapper-replacement" },
            "disposition": { "enum": ["rotate", "retire"] }
          },
          "required": ["secret_class", "action_kind", "disposition"]
        },
        {
          "properties": {
            "secret_class": { "const": "config-audience" },
            "action_kind": { "const": "audience-key-rotation" },
            "disposition": { "const": "rotate" }
          },
          "required": ["secret_class", "action_kind", "disposition"]
        },
        {
          "properties": {
            "secret_class": { "enum": ["tier3-audience", "claim-ledger-audience"] },
            "action_kind": { "const": "audience-key-rotation" },
            "disposition": { "enum": ["rotate", "retire"] }
          },
          "required": ["secret_class", "action_kind", "disposition"]
        },
        {
          "properties": {
            "secret_class": { "const": "object-dek" },
            "action_kind": { "const": "object-key-replacement" },
            "disposition": { "enum": ["rotate", "retire"] }
          },
          "required": ["secret_class", "action_kind", "disposition"]
        },
        {
          "properties": {
            "secret_class": { "const": "radicle-access" },
            "action_kind": { "const": "repository-access-revocation" },
            "disposition": { "enum": ["revoke-reissue", "retire"] }
          },
          "required": ["secret_class", "action_kind", "disposition"]
        },
        {
          "properties": {
            "secret_class": { "enum": ["oauth-signing", "oauth-pairwise"] },
            "action_kind": { "const": "credential-revocation" },
            "disposition": { "const": "rotate" }
          },
          "required": ["secret_class", "action_kind", "disposition"]
        },
        {
          "properties": {
            "secret_class": { "const": "bearer-credential" },
            "action_kind": { "const": "credential-revocation" },
            "disposition": { "enum": ["revoke-reissue", "retire"] }
          },
          "required": ["secret_class", "action_kind", "disposition"]
        },
        {
          "properties": {
            "secret_class": {
              "enum": ["ssh-client", "ssh-host", "onion-service-identity", "tls-serving"]
            },
            "action_kind": { "const": "endpoint-identity-replacement" },
            "disposition": { "enum": ["rotate", "retire"] }
          },
          "required": ["secret_class", "action_kind", "disposition"]
        }
      ]
    }
  ],
  "definitions": {
    "secret_class": {
      "enum": [
        "cold-root",
        "epoch",
        "device-signing",
        "agent-signing",
        "core-protected",
        "config-audience",
        "tier3-audience",
        "claim-ledger-audience",
        "object-dek",
        "radicle-access",
        "oauth-signing",
        "oauth-pairwise",
        "bearer-credential",
        "ssh-client",
        "ssh-host",
        "recovery-wrap",
        "onion-service-identity",
        "tls-serving"
      ]
    },
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hex128": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "json_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "canonical_nid": {
      "type": "string",
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "kel_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "seq"],
      "properties": {
        "event_id": { "$ref": "#/definitions/hex64" },
        "seq": { "$ref": "#/definitions/json_safe_integer" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer_type", "signer", "kel_head"],
      "properties": {
        "signer_type": { "enum": ["epoch", "cold-root"] },
        "signer": { "$ref": "#/definitions/hex64" },
        "kel_head": { "$ref": "#/definitions/kel_head" }
      }
    },
    "nid_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/canonical_nid" }
    },
    "digest_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/hex64" }
    },
    "pre_unseal_intent_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_record_digest", "preimage_id"],
      "properties": {
        "intent_record_digest": { "$ref": "#/definitions/hex64" },
        "preimage_id": { "$ref": "#/definitions/hex64" }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "record_digest"],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "record_digest": { "$ref": "#/definitions/hex64" }
      }
    }
  }
}
