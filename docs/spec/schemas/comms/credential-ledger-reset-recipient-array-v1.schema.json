{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/credential-ledger-reset-recipient-array-v1.schema.json",
  "title": "Heterodyne credential-ledger reset recipient array v1",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "nid",
      "delegation_event_id",
      "recovery_key",
      "nid_proof",
      "enc",
      "ciphertext"
    ],
    "properties": {
      "nid": { "$ref": "#/definitions/canonical_nid" },
      "delegation_event_id": { "$ref": "#/definitions/hex64" },
      "recovery_key": {
        "type": "object",
        "additionalProperties": false,
        "required": ["algorithm", "public_key"],
        "properties": {
          "algorithm": { "const": "X25519" },
          "public_key": { "$ref": "#/definitions/base64url_32_bytes" }
        }
      },
      "nid_proof": { "$ref": "#/definitions/base64url_64_bytes" },
      "enc": { "$ref": "#/definitions/base64url_32_bytes" },
      "ciphertext": { "$ref": "#/definitions/base64url_nonempty" }
    }
  },
  "definitions": {
    "canonical_nid": {
      "type": "string",
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base64url_32_bytes": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "base64url_64_bytes": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    },
    "base64url_nonempty": {
      "type": "string",
      "minLength": 2,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
    }
  }
}
