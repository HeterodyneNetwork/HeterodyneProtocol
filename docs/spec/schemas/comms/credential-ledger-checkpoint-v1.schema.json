{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/credential-ledger-checkpoint-v1.schema.json",
  "title": "Heterodyne Comms credential ledger checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "persona",
    "generation",
    "sequence",
    "previous_checkpoint",
    "record_set_digest",
    "node_roster",
    "config_head",
    "config_key_id",
    "config_key_sha256",
    "pairwise_secret_sha256",
    "exposure_set_sha256",
    "config_bootstrap_recipients_digest",
    "governed_decrypt_key_bindings_sha256",
    "historical_decrypt_obligations_sha256",
    "secret_transition_digest",
    "generation_transition",
    "epoch_pubkey",
    "kel_head",
    "created_at",
    "epoch_signature"
  ],
  "properties": {
    "type": {
      "const": "heterodyne.credential-ledger.checkpoint.v1"
    },
    "persona": {
      "$ref": "#/definitions/sha256"
    },
    "generation": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "sequence": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "previous_checkpoint": {
      "$ref": "#/definitions/nullable_sha256"
    },
    "record_set_digest": {
      "$ref": "#/definitions/sha256"
    },
    "node_roster": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/nid"
      }
    },
    "config_head": {
      "$ref": "#/definitions/typed_git_object"
    },
    "config_key_id": {
      "$ref": "#/definitions/id_16"
    },
    "config_key_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "pairwise_secret_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "exposure_set_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "config_bootstrap_recipients_digest": {
      "$ref": "#/definitions/nullable_sha256"
    },
    "governed_decrypt_key_bindings_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "historical_decrypt_obligations_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "secret_transition_digest": {
      "$ref": "#/definitions/nullable_sha256"
    },
    "generation_transition": {
      "$ref": "#/definitions/nullable_sha256"
    },
    "epoch_pubkey": {
      "$ref": "#/definitions/sha256"
    },
    "kel_head": {
      "$ref": "#/definitions/kel_head"
    },
    "created_at": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "epoch_signature": {
      "$ref": "#/definitions/bip340_signature"
    }
  },
  "oneOf": [
    {
      "properties": {
        "generation": {
          "const": 0
        },
        "sequence": {
          "const": 0
        },
        "previous_checkpoint": {
          "type": "null"
        },
        "generation_transition": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "previous_checkpoint": {
          "$ref": "#/definitions/sha256"
        },
        "generation_transition": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sequence": {
          "const": 0
        },
        "previous_checkpoint": {
          "type": "null"
        },
        "generation_transition": {
          "$ref": "#/definitions/sha256"
        }
      }
    }
  ],
  "definitions": {
    "id_16": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/sha256"
        }
      ]
    },
    "bip340_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "json_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nid": {
      "type": "string",
      "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]+$",
      "maxLength": 128
    },
    "git_sha1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_format",
        "oid"
      ],
      "properties": {
        "object_format": {
          "const": "sha1"
        },
        "oid": {
          "$ref": "#/definitions/sha1"
        }
      }
    },
    "git_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_format",
        "oid"
      ],
      "properties": {
        "object_format": {
          "const": "sha256"
        },
        "oid": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "typed_git_object": {
      "oneOf": [
        {
          "$ref": "#/definitions/git_sha1"
        },
        {
          "$ref": "#/definitions/git_sha256"
        }
      ]
    },
    "kel_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "seq"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/definitions/sha256"
        },
        "seq": {
          "$ref": "#/definitions/json_safe_integer"
        }
      }
    }
  }
}
