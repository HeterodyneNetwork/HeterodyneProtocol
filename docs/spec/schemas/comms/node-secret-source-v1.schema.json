{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/node-secret-source-v1.schema.json",
  "title": "Heterodyne node secret source v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "persona",
    "secret_class",
    "secret_id",
    "instance_commitment",
    "holder_nid",
    "commitment_kind",
    "source_kind",
    "artifact_refs",
    "issued_at",
    "epoch_pubkey",
    "kel_head",
    "epoch_signature"
  ],
  "properties": {
    "type": { "const": "heterodyne.node-secret-source.v1" },
    "persona": { "$ref": "#/definitions/hex64" },
    "secret_class": { "$ref": "#/definitions/secret_class" },
    "secret_id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{32}|[0-9a-f]{64})$"
    },
    "instance_commitment": { "$ref": "#/definitions/hex64" },
    "holder_nid": { "$ref": "#/definitions/canonical_nid" },
    "commitment_kind": {
      "enum": ["secret-bytes", "capability-jcs"]
    },
    "source_kind": {
      "enum": ["canonical-artifact", "local-protected-state"]
    },
    "artifact_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/artifact_ref" }
    },
    "issued_at": { "$ref": "#/definitions/json_safe_integer" },
    "epoch_pubkey": { "$ref": "#/definitions/hex64" },
    "kel_head": { "$ref": "#/definitions/kel_head" },
    "epoch_signature": { "$ref": "#/definitions/hex128" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "secret_class": { "const": "config-audience" } },
        "required": ["secret_class"]
      },
      "then": {
        "properties": { "secret_id": { "$ref": "#/definitions/hex32" } }
      },
      "else": {
        "properties": { "secret_id": { "$ref": "#/definitions/hex64" } }
      }
    },
    {
      "if": {
        "properties": {
          "secret_class": {
            "enum": [
              "config-audience",
              "tier3-audience",
              "claim-ledger-audience",
              "object-dek",
              "oauth-pairwise",
              "bearer-credential",
              "recovery-wrap"
            ]
          }
        },
        "required": ["secret_class"]
      },
      "then": {
        "properties": { "commitment_kind": { "const": "secret-bytes" } }
      },
      "else": {
        "properties": { "commitment_kind": { "const": "capability-jcs" } }
      }
    },
    {
      "if": {
        "properties": { "source_kind": { "const": "canonical-artifact" } },
        "required": ["source_kind"]
      },
      "then": {
        "properties": { "artifact_refs": { "minItems": 1 } }
      }
    }
  ],
  "definitions": {
    "secret_class": {
      "enum": [
        "cold-root",
        "epoch",
        "device-signing",
        "agent-signing",
        "core-protected",
        "config-audience",
        "tier3-audience",
        "claim-ledger-audience",
        "object-dek",
        "radicle-access",
        "oauth-signing",
        "oauth-pairwise",
        "bearer-credential",
        "ssh-client",
        "ssh-host",
        "recovery-wrap",
        "onion-service-identity",
        "tls-serving"
      ]
    },
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hex128": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "json_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "canonical_nid": {
      "type": "string",
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "kel_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "seq"],
      "properties": {
        "event_id": { "$ref": "#/definitions/hex64" },
        "seq": { "$ref": "#/definitions/json_safe_integer" }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "record_digest"],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "record_digest": { "$ref": "#/definitions/hex64" }
      }
    }
  }
}
