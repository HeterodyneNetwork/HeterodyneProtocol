{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/credential-ledger-checkpoint-receipt-v1.schema.json",
  "title": "Heterodyne Comms credential ledger checkpoint receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "checkpoint_digest",
    "node_nid",
    "observed_at",
    "signature"
  ],
  "properties": {
    "type": {
      "const": "heterodyne.credential-ledger.checkpoint-receipt.v1"
    },
    "checkpoint_digest": {
      "$ref": "#/definitions/sha256"
    },
    "node_nid": {
      "$ref": "#/definitions/nid"
    },
    "observed_at": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "signature": {
      "$ref": "#/definitions/ed25519_signature"
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "json_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nid": {
      "type": "string",
      "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]+$",
      "maxLength": 128
    },
    "ed25519_signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    }
  }
}
