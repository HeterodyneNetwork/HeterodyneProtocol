{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/marmot-persona-inbox-manifest-v1.schema.json",
  "title": "Heterodyne Marmot persona inbox quarantine manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "sender_nid",
    "consumed_keypackage_id",
    "welcome_event_id",
    "first_group_event_id",
    "objects",
    "automation"
  ],
  "properties": {
    "spec_version": {
      "const": "heterodyne/0.5.0"
    },
    "sender_nid": {
      "type": "string",
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "consumed_keypackage_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "welcome_event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "first_group_event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "objects": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "media_type",
          "encoded_bytes",
          "sha256"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "encoded_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 104857600
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automated"
      ],
      "properties": {
        "automated": {
          "type": "boolean"
        },
        "agent_role_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
