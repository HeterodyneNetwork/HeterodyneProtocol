{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/credential-ledger-staging-ref-cleanup-v1.schema.json",
  "title": "Heterodyne Comms credential ledger staging ref cleanup v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "persona",
    "staging_config_key_id",
    "staging_ref",
    "staging_head",
    "staging_transition_id",
    "staging_transition_digest",
    "staging_baseline_head",
    "terminalization",
    "accepted_transition_id",
    "accepted_transition_digest",
    "accepted_checkpoint_digest",
    "active_ref",
    "active_basis_head",
    "staging_storage_object_set_sha256",
    "inherited_audit_set_digests",
    "opaque_object_manifest",
    "opaque_object_manifest_sha256",
    "safe_record_copies",
    "safe_record_set_sha256",
    "assignment_record_digests",
    "adopted_epoch_assignment_digests",
    "retirement_record_digests",
    "cleaned_at",
    "epoch_pubkey",
    "kel_head",
    "epoch_signature"
  ],
  "properties": {
    "type": {
      "const": "heterodyne.credential-ledger.staging-ref-cleanup.v1"
    },
    "persona": {
      "$ref": "#/definitions/sha256"
    },
    "staging_config_key_id": {
      "$ref": "#/definitions/id_16"
    },
    "staging_ref": {
      "$ref": "#/definitions/config_ref"
    },
    "staging_head": {
      "$ref": "#/definitions/typed_git_object"
    },
    "staging_transition_id": {
      "$ref": "#/definitions/id_16"
    },
    "staging_transition_digest": {
      "$ref": "#/definitions/sha256"
    },
    "staging_baseline_head": {
      "$ref": "#/definitions/typed_git_object"
    },
    "terminalization": {
      "$ref": "#/definitions/terminalization"
    },
    "accepted_transition_id": {
      "$ref": "#/definitions/id_16"
    },
    "accepted_transition_digest": {
      "$ref": "#/definitions/sha256"
    },
    "accepted_checkpoint_digest": {
      "$ref": "#/definitions/sha256"
    },
    "active_ref": {
      "$ref": "#/definitions/config_ref"
    },
    "active_basis_head": {
      "$ref": "#/definitions/typed_git_object"
    },
    "staging_storage_object_set_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "inherited_audit_set_digests": {
      "$ref": "#/definitions/digest_set"
    },
    "opaque_object_manifest": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/opaque_object"
      }
    },
    "opaque_object_manifest_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "safe_record_copies": {
      "type": "array",
      "maxItems": 1000000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/safe_record_copy"
      }
    },
    "safe_record_set_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "assignment_record_digests": {
      "allOf": [
        {
          "$ref": "#/definitions/digest_set"
        },
        {
          "minItems": 1
        }
      ]
    },
    "adopted_epoch_assignment_digests": {
      "$ref": "#/definitions/digest_set"
    },
    "retirement_record_digests": {
      "$ref": "#/definitions/digest_set"
    },
    "cleaned_at": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "epoch_pubkey": {
      "$ref": "#/definitions/sha256"
    },
    "kel_head": {
      "$ref": "#/definitions/kel_head"
    },
    "epoch_signature": {
      "$ref": "#/definitions/bip340_signature"
    }
  },
  "definitions": {
    "id_16": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_oid": {
      "oneOf": [
        {
          "$ref": "#/definitions/sha1"
        },
        {
          "$ref": "#/definitions/sha256"
        }
      ]
    },
    "bip340_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "json_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "config_ref": {
      "type": "string",
      "pattern": "^refs/heads/enc/[0-9a-f]{32}$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*//)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "git_sha1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_format",
        "oid"
      ],
      "properties": {
        "object_format": {
          "const": "sha1"
        },
        "oid": {
          "$ref": "#/definitions/sha1"
        }
      }
    },
    "git_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_format",
        "oid"
      ],
      "properties": {
        "object_format": {
          "const": "sha256"
        },
        "oid": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "typed_git_object": {
      "oneOf": [
        {
          "$ref": "#/definitions/git_sha1"
        },
        {
          "$ref": "#/definitions/git_sha256"
        }
      ]
    },
    "kel_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "seq"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/definitions/sha256"
        },
        "seq": {
          "$ref": "#/definitions/json_safe_integer"
        }
      }
    },
    "digest_set": {
      "type": "array",
      "maxItems": 1000000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/sha256"
      }
    },
    "terminalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "record_digest",
        "acceptance_head"
      ],
      "properties": {
        "kind": {
          "enum": [
            "candidate-abandonment",
            "emergency-reset"
          ]
        },
        "record_digest": {
          "$ref": "#/definitions/sha256"
        },
        "acceptance_head": {
          "$ref": "#/definitions/typed_git_object"
        }
      }
    },
    "opaque_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "object_id",
        "raw_sha256",
        "paths",
        "disposition",
        "audit_path",
        "audit_sha256",
        "inherited_audit_set_digests"
      ],
      "properties": {
        "object_type": {
          "enum": [
            "commit",
            "tree",
            "blob"
          ]
        },
        "object_id": {
          "$ref": "#/definitions/git_oid"
        },
        "raw_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "paths": {
          "type": "array",
          "maxItems": 1000000,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "const": ""
              },
              {
                "$ref": "#/definitions/repository_path"
              }
            ]
          }
        },
        "disposition": {
          "enum": [
            "opaque-copy",
            "inherited-reference"
          ]
        },
        "audit_path": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/repository_path"
            }
          ]
        },
        "audit_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/sha256"
            }
          ]
        },
        "inherited_audit_set_digests": {
          "$ref": "#/definitions/digest_set"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "object_type": {
                "const": "commit"
              }
            },
            "required": [
              "object_type"
            ]
          },
          "then": {
            "properties": {
              "paths": {
                "maxItems": 0
              },
              "disposition": {
                "const": "opaque-copy"
              }
            }
          },
          "else": {
            "properties": {
              "paths": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "inherited-reference"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "audit_path": {
                "type": "null"
              },
              "audit_sha256": {
                "type": "null"
              },
              "inherited_audit_set_digests": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "audit_path": {
                "$ref": "#/definitions/repository_path"
              },
              "audit_sha256": {
                "$ref": "#/definitions/sha256"
              },
              "inherited_audit_set_digests": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "safe_record_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "record_digest",
        "source_path",
        "audit_path",
        "audit_sha256"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/definitions/profile_id"
        },
        "record_digest": {
          "$ref": "#/definitions/sha256"
        },
        "source_path": {
          "$ref": "#/definitions/repository_path"
        },
        "audit_path": {
          "$ref": "#/definitions/repository_path"
        },
        "audit_sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    }
  }
}
