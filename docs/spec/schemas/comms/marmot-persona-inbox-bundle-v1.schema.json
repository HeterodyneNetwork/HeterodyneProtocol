{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/marmot-persona-inbox-bundle-v1.schema.json",
  "title": "Heterodyne Marmot persona inbox contact bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "manifest",
    "welcome",
    "first_group_event",
    "atomic_commit"
  ],
  "properties": {
    "spec_version": {
      "const": "heterodyne/0.5.0"
    },
    "manifest": {
      "$ref": "marmot-persona-inbox-manifest-v1.schema.json"
    },
    "welcome": {
      "$ref": "#/definitions/exactNostrEvent"
    },
    "first_group_event": {
      "allOf": [
        {
          "$ref": "#/definitions/exactNostrEvent"
        },
        {
          "properties": {
            "event": {
              "properties": {
                "kind": {
                  "const": 445
                }
              }
            }
          }
        }
      ]
    },
    "atomic_commit": {
      "const": true
    }
  },
  "definitions": {
    "exactNostrEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nip01_raw",
        "event"
      ],
      "properties": {
        "nip01_raw": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "pubkey",
            "created_at",
            "kind",
            "tags",
            "content",
            "sig"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "pubkey": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "created_at": {
              "type": "integer",
              "minimum": 0
            },
            "kind": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "content": {
              "type": "string"
            },
            "sig": {
              "type": "string",
              "pattern": "^[0-9a-f]{128}$"
            }
          }
        }
      }
    }
  }
}
