{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/credential-ledger-secret-transition-v1.schema.json",
  "title": "Heterodyne credential-ledger secret transition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "transition_id",
    "persona",
    "mode",
    "prior_checkpoint",
    "added_nids",
    "removed_nids",
    "target",
    "inventory_basis",
    "result_basis",
    "exposures",
    "outcomes",
    "created_at",
    "authority",
    "signature"
  ],
  "properties": {
    "type": { "const": "heterodyne.credential-ledger.secret-transition.v1" },
    "transition_id": { "$ref": "#/definitions/hex32" },
    "persona": { "$ref": "#/definitions/hex64" },
    "mode": {
      "enum": [
        "routine-key-rotation",
        "routine-addition",
        "routine-removal",
        "emergency-reset"
      ]
    },
    "prior_checkpoint": { "$ref": "#/definitions/hex64" },
    "added_nids": { "$ref": "#/definitions/nid_array" },
    "removed_nids": { "$ref": "#/definitions/nid_array" },
    "target": { "$ref": "#/definitions/target" },
    "inventory_basis": { "$ref": "#/definitions/inventory_basis" },
    "result_basis": { "$ref": "#/definitions/result_basis" },
    "exposures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/exposure" }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/outcome" }
    },
    "created_at": { "$ref": "#/definitions/json_safe_integer" },
    "authority": { "$ref": "#/definitions/authority" },
    "signature": { "$ref": "#/definitions/hex128" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "emergency-reset" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "sequence": { "const": 0 },
              "reset_id": { "$ref": "#/definitions/hex32" },
              "epoch_rotation_event_id": { "$ref": "#/definitions/hex64" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "target": {
            "properties": {
              "reset_id": { "type": "null" }
            }
          },
          "inventory_basis": {
            "properties": {
              "offline_recovery_pre_unseal_intent_collisions": { "maxItems": 0 },
              "offline_recovery_activation_collisions": { "maxItems": 0 },
              "same_key_candidate_audit": { "type": "null" }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "secret_class": {
      "enum": [
        "cold-root",
        "epoch",
        "device-signing",
        "agent-signing",
        "core-protected",
        "config-audience",
        "tier3-audience",
        "claim-ledger-audience",
        "object-dek",
        "double-ratchet",
        "radicle-access",
        "oauth-signing",
        "oauth-pairwise",
        "bearer-credential",
        "ssh-client",
        "ssh-host",
        "recovery-wrap",
        "onion-service-identity",
        "tls-serving"
      ]
    },
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "hex40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hex128": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "json_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "canonical_nid": {
      "type": "string",
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "nid_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/canonical_nid" }
    },
    "digest_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/hex64" }
    },
    "typed_git_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_format", "oid"],
      "properties": {
        "object_format": { "enum": ["sha1", "sha256"] },
        "oid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "oneOf": [
        {
          "properties": {
            "object_format": { "const": "sha1" },
            "oid": { "$ref": "#/definitions/hex40" }
          }
        },
        {
          "properties": {
            "object_format": { "const": "sha256" },
            "oid": { "$ref": "#/definitions/hex64" }
          }
        }
      ]
    },
    "kel_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "seq"],
      "properties": {
        "event_id": { "$ref": "#/definitions/hex64" },
        "seq": { "$ref": "#/definitions/json_safe_integer" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer_type", "signer", "kel_head"],
      "properties": {
        "signer_type": { "enum": ["epoch", "cold-root"] },
        "signer": { "$ref": "#/definitions/hex64" },
        "kel_head": { "$ref": "#/definitions/kel_head" }
      }
    },
    "pre_unseal_intent_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_record_digest", "preimage_id"],
      "properties": {
        "intent_record_digest": { "$ref": "#/definitions/hex64" },
        "preimage_id": { "$ref": "#/definitions/hex64" }
      }
    },
    "candidate_exposure_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "record_digest"],
      "properties": {
        "record_type": { "enum": ["secret-source", "secret-assignment"] },
        "record_digest": { "$ref": "#/definitions/hex64" }
      }
    },
    "offline_intent_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_id",
        "intent_record_digest",
        "exposure_preimage_set_sha256"
      ],
      "properties": {
        "activation_id": { "$ref": "#/definitions/hex32" },
        "intent_record_digest": { "$ref": "#/definitions/hex64" },
        "exposure_preimage_set_sha256": { "$ref": "#/definitions/hex64" }
      }
    },
    "offline_intent_collision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_id", "intent_record_digests"],
      "properties": {
        "activation_id": { "$ref": "#/definitions/hex32" },
        "intent_record_digests": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/hex64" }
        }
      }
    },
    "offline_activation_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_id",
        "activation_record_digest",
        "provisional_exposure_set_sha256"
      ],
      "properties": {
        "activation_id": { "$ref": "#/definitions/hex32" },
        "activation_record_digest": { "$ref": "#/definitions/hex64" },
        "provisional_exposure_set_sha256": { "$ref": "#/definitions/hex64" }
      }
    },
    "offline_activation_collision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_id", "activation_record_digests"],
      "properties": {
        "activation_id": { "$ref": "#/definitions/hex32" },
        "activation_record_digests": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/hex64" }
        }
      }
    },
    "signed_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "head"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^refs/heads/enc/[0-9a-f]{32}$"
        },
        "head": { "$ref": "#/definitions/typed_git_object" }
      }
    },
    "opaque_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "object_id",
        "raw_sha256",
        "paths",
        "disposition",
        "audit_path",
        "audit_sha256",
        "inherited_audit_set_digests"
      ],
      "properties": {
        "object_type": { "enum": ["commit", "tree", "blob"] },
        "object_id": { "$ref": "#/definitions/typed_git_object" },
        "raw_sha256": { "$ref": "#/definitions/hex64" },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "disposition": { "enum": ["opaque-copy", "inherited-reference"] },
        "audit_path": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "audit_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/hex64" }
          ]
        },
        "inherited_audit_set_digests": { "$ref": "#/definitions/digest_array" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "inherited-reference" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "audit_path": { "type": "null" },
              "audit_sha256": { "type": "null" },
              "inherited_audit_set_digests": { "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "audit_path": { "type": "string", "minLength": 1 },
              "audit_sha256": { "$ref": "#/definitions/hex64" },
              "inherited_audit_set_digests": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "safe_record_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "record_digest",
        "source_path",
        "audit_path",
        "audit_sha256"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "record_digest": { "$ref": "#/definitions/hex64" },
        "source_path": { "type": "string", "minLength": 1 },
        "audit_path": { "type": "string", "minLength": 1 },
        "audit_sha256": { "$ref": "#/definitions/hex64" }
      }
    },
    "same_key_candidate_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor_checkpoint",
        "candidate_checkpoint_digest",
        "accepted_basis_head",
        "candidate_head",
        "candidate_exposure_records",
        "candidate_governed_decrypt_key_bindings_sha256",
        "candidate_historical_decrypt_obligations_sha256",
        "opaque_object_manifest",
        "opaque_object_manifest_sha256",
        "safe_record_copies",
        "safe_record_set_sha256"
      ],
      "properties": {
        "predecessor_checkpoint": { "$ref": "#/definitions/hex64" },
        "candidate_checkpoint_digest": { "$ref": "#/definitions/hex64" },
        "accepted_basis_head": { "$ref": "#/definitions/typed_git_object" },
        "candidate_head": { "$ref": "#/definitions/typed_git_object" },
        "candidate_exposure_records": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/candidate_exposure_record" }
        },
        "candidate_governed_decrypt_key_bindings_sha256": { "$ref": "#/definitions/hex64" },
        "candidate_historical_decrypt_obligations_sha256": { "$ref": "#/definitions/hex64" },
        "opaque_object_manifest": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/opaque_object" }
        },
        "opaque_object_manifest_sha256": { "$ref": "#/definitions/hex64" },
        "safe_record_copies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/safe_record_copy" }
        },
        "safe_record_set_sha256": { "$ref": "#/definitions/hex64" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "sequence",
        "new_roster",
        "config_key_id",
        "config_key_sha256",
        "pairwise_secret_sha256",
        "exposure_set_sha256",
        "governed_decrypt_key_bindings_sha256",
        "historical_decrypt_obligations_sha256",
        "epoch_pubkey",
        "kel_head",
        "reset_id",
        "epoch_rotation_event_id"
      ],
      "properties": {
        "generation": { "$ref": "#/definitions/json_safe_integer" },
        "sequence": { "$ref": "#/definitions/json_safe_integer" },
        "new_roster": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/canonical_nid" }
        },
        "config_key_id": { "$ref": "#/definitions/hex32" },
        "config_key_sha256": { "$ref": "#/definitions/hex64" },
        "pairwise_secret_sha256": { "$ref": "#/definitions/hex64" },
        "exposure_set_sha256": { "$ref": "#/definitions/hex64" },
        "governed_decrypt_key_bindings_sha256": { "$ref": "#/definitions/hex64" },
        "historical_decrypt_obligations_sha256": { "$ref": "#/definitions/hex64" },
        "epoch_pubkey": { "$ref": "#/definitions/hex64" },
        "kel_head": { "$ref": "#/definitions/kel_head" },
        "reset_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/hex32" }
          ]
        },
        "epoch_rotation_event_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/hex64" }
          ]
        }
      }
    },
    "inventory_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_head",
        "source_ref_head",
        "staging_heads",
        "recovered_heads",
        "offline_recovery_pre_unseal_intents",
        "offline_recovery_pre_unseal_intent_collisions",
        "offline_recovery_activations",
        "offline_recovery_activation_collisions",
        "same_key_candidate_audit",
        "signed_ref_map",
        "signed_ref_map_sha256",
        "exposure_set_sha256",
        "governed_decrypt_key_bindings_sha256",
        "historical_decrypt_obligations_sha256"
      ],
      "properties": {
        "config_head": { "$ref": "#/definitions/typed_git_object" },
        "source_ref_head": { "$ref": "#/definitions/typed_git_object" },
        "staging_heads": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/typed_git_object" }
        },
        "recovered_heads": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/typed_git_object" }
        },
        "offline_recovery_pre_unseal_intents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/offline_intent_inventory" }
        },
        "offline_recovery_pre_unseal_intent_collisions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/offline_intent_collision" }
        },
        "offline_recovery_activations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/offline_activation_inventory" }
        },
        "offline_recovery_activation_collisions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/offline_activation_collision" }
        },
        "same_key_candidate_audit": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/same_key_candidate_audit" }
          ]
        },
        "signed_ref_map": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/signed_ref" }
        },
        "signed_ref_map_sha256": { "$ref": "#/definitions/hex64" },
        "exposure_set_sha256": { "$ref": "#/definitions/hex64" },
        "governed_decrypt_key_bindings_sha256": { "$ref": "#/definitions/hex64" },
        "historical_decrypt_obligations_sha256": { "$ref": "#/definitions/hex64" }
      }
    },
    "result_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_head",
        "exposure_set_sha256",
        "governed_decrypt_key_bindings_sha256",
        "historical_decrypt_obligations_sha256"
      ],
      "properties": {
        "config_head": { "$ref": "#/definitions/typed_git_object" },
        "exposure_set_sha256": { "$ref": "#/definitions/hex64" },
        "governed_decrypt_key_bindings_sha256": { "$ref": "#/definitions/hex64" },
        "historical_decrypt_obligations_sha256": { "$ref": "#/definitions/hex64" }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_class",
        "secret_id",
        "secret_commitment",
        "holder_nids",
        "assignment_record_digests",
        "pre_unseal_intent_items"
      ],
      "properties": {
        "secret_class": { "$ref": "#/definitions/secret_class" },
        "secret_id": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{32}|[0-9a-f]{64})$"
        },
        "secret_commitment": { "$ref": "#/definitions/hex64" },
        "holder_nids": { "$ref": "#/definitions/nid_array" },
        "assignment_record_digests": { "$ref": "#/definitions/digest_array" },
        "pre_unseal_intent_items": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/pre_unseal_intent_item" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "secret_class": { "const": "config-audience" } },
            "required": ["secret_class"]
          },
          "then": {
            "properties": { "secret_id": { "$ref": "#/definitions/hex32" } }
          },
          "else": {
            "properties": { "secret_id": { "$ref": "#/definitions/hex64" } }
          }
        },
        {
          "anyOf": [
            { "properties": { "assignment_record_digests": { "minItems": 1 } } },
            { "properties": { "pre_unseal_intent_items": { "minItems": 1 } } }
          ]
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_class",
        "secret_id",
        "old_commitment",
        "disposition",
        "successor_id",
        "proof_digests"
      ],
      "properties": {
        "secret_class": { "$ref": "#/definitions/secret_class" },
        "secret_id": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{32}|[0-9a-f]{64})$"
        },
        "old_commitment": { "$ref": "#/definitions/hex64" },
        "disposition": {
          "enum": [
            "rotate",
            "terminate",
            "revoke-reissue",
            "retire",
            "persona-migration-required"
          ]
        },
        "successor_id": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{32}|[0-9a-f]{64})$"
            }
          ]
        },
        "proof_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/hex64" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "secret_class": { "const": "config-audience" } },
            "required": ["secret_class"]
          },
          "then": {
            "properties": {
              "secret_id": { "$ref": "#/definitions/hex32" },
              "successor_id": {
                "oneOf": [
                  { "type": "null" },
                  { "$ref": "#/definitions/hex32" }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "secret_id": { "$ref": "#/definitions/hex64" },
              "successor_id": {
                "oneOf": [
                  { "type": "null" },
                  { "$ref": "#/definitions/hex64" }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": { "enum": ["rotate", "revoke-reissue"] }
            },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "successor_id": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{32}|[0-9a-f]{64})$"
              }
            }
          },
          "else": {
            "properties": {
              "successor_id": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
