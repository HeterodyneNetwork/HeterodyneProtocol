{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/oidc-continuity-manifest-v1.schema.json",
  "title": "Heterodyne Comms OIDC continuity manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile", "repository_rid", "branch", "persona_npub", "persona_key",
    "issuer", "sequence", "predecessor_digest", "max_checkpoint_age_seconds",
    "authorization_view_max_age",
    "current_jwks_sha256", "current_signing_key_id", "current_signing_jwk_sha256",
    "retiring_signing_key_ids", "retiring_jwks_sha256", "status_lists",
    "successor", "authority", "authority_proof"
  ],
  "properties": {
    "profile": { "const": "heterodyne-oidc-continuity-v1" },
    "repository_rid": { "type": "string", "pattern": "^rad:z[1-9A-HJ-NP-Za-km-z]+$" },
    "branch": { "const": "main" },
    "persona_npub": { "$ref": "#/definitions/npub" },
    "persona_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "issuer": { "type": "string", "pattern": "^https://[^/?#]+/oidc/npub1[023456789acdefghjklmnpqrstuvwxyz]+$" },
    "sequence": { "$ref": "#/definitions/json_safe_integer" },
    "predecessor_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "max_checkpoint_age_seconds": { "type": "integer", "minimum": 0, "maximum": 300 },
    "authorization_view_max_age": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "current_jwks_sha256": { "$ref": "#/definitions/sha256" },
    "current_signing_key_id": { "$ref": "#/definitions/jwk_thumbprint" },
    "current_signing_jwk_sha256": { "$ref": "#/definitions/sha256" },
    "retiring_signing_key_ids": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "#/definitions/jwk_thumbprint" }
    },
    "retiring_jwks_sha256": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "#/definitions/sha256" }
    },
    "status_lists": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "issuer", "uri"],
        "properties": {
          "path": { "type": "string", "pattern": "^\\.well-known/npub1[^/]+/status-lists/(0|[1-9][0-9]*)/[0-9a-f]{32}/(0|[1-9][0-9]*)\\.jwt$" },
          "sha256": { "$ref": "#/definitions/sha256" },
          "issuer": { "type": "string", "pattern": "^https://[^/?#]+/oidc/npub1[023456789acdefghjklmnpqrstuvwxyz]+$" },
          "uri": { "type": "string", "pattern": "^https://[^/?#]+/oidc/npub1[023456789acdefghjklmnpqrstuvwxyz]+/status-lists/(0|[1-9][0-9]*)/[0-9a-f]{32}/(0|[1-9][0-9]*)\\.jwt$" }
        }
      }
    },
    "successor": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["issuer", "manifest_sha256"],
          "properties": {
            "issuer": { "type": "string", "pattern": "^https://[^/?#]+/oidc/npub1[023456789acdefghjklmnpqrstuvwxyz]+$" },
            "manifest_sha256": { "$ref": "#/definitions/sha256" }
          }
        }
      ]
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["writer_nid", "issued_at", "checkpoint"],
      "properties": {
        "writer_nid": { "type": "string", "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$" },
        "issued_at": { "$ref": "#/definitions/json_safe_integer" },
        "checkpoint": {
          "type": "object", "additionalProperties": false,
          "required": ["repository_rid", "branch", "commit_oid", "observed_at"],
          "properties": {
            "repository_rid": { "type": "string", "pattern": "^rad:z[1-9A-HJ-NP-Za-km-z]+$" },
            "branch": { "const": "main" },
            "commit_oid": { "$ref": "#/definitions/sha256" },
            "observed_at": { "$ref": "#/definitions/json_safe_integer" }
          }
        }
      }
    },
    "authority_proof": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "public_key", "signature"],
      "properties": {
        "type": { "const": "radicle-ed25519" },
        "public_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    }
  },
  "definitions": {
    "npub": { "type": "string", "pattern": "^npub1[023456789acdefghjklmnpqrstuvwxyz]+$" },
    "jwk_thumbprint": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "json_safe_integer": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
