{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/claim-ledger-record-v1.schema.json",
  "title": "Heterodyne Comms private claim-ledger record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "record_type",
    "persona",
    "writer_nid",
    "created_at",
    "parents",
    "payload",
    "payload_digest",
    "signature"
  ],
  "properties": {
    "record_id": { "$ref": "#/definitions/sha256" },
    "record_type": {
      "type": "string",
      "enum": [
        "claim",
        "revocation",
        "authority-reduction",
        "reader-change",
        "audience-key-epoch",
        "issuer-authority",
        "issuance-reservation",
        "status-invalidation"
      ]
    },
    "persona": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "writer_nid": { "$ref": "#/definitions/nid" },
    "created_at": { "$ref": "#/definitions/json_safe_integer" },
    "parents": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/sha256" }
    },
    "payload": { "type": "object" },
    "payload_digest": { "$ref": "#/definitions/sha256" },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "record_type": { "const": "claim" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim"],
            "properties": { "claim": { "type": "object" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "revocation" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "reason_code", "evidence"],
            "properties": {
              "claim_id": { "$ref": "#/definitions/sha256" },
              "reason_code": { "type": "string", "minLength": 1, "maxLength": 128 },
              "evidence": { "$ref": "#/definitions/reduction_evidence" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "authority-reduction" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "subject_nid", "authority", "evidence"],
            "properties": {
              "claim_id": { "$ref": "#/definitions/sha256" },
              "subject_nid": { "$ref": "#/definitions/nid" },
              "authority": { "enum": ["claim-ledger-reader", "oidc-token-issuer"] },
              "evidence": { "$ref": "#/definitions/reduction_evidence" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "reader-change" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "reader_nid", "action"],
            "properties": {
              "claim_id": { "$ref": "#/definitions/sha256" },
              "reader_nid": { "$ref": "#/definitions/nid" },
              "action": { "enum": ["grant", "remove"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "audience-key-epoch" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key_id", "reader_nids", "removed_reader_nids", "radicle_access_removed", "retire_previous_state", "scrub_profile"],
            "properties": {
              "key_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
              "previous_key_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
              "reader_nids": { "$ref": "#/definitions/nids" },
              "removed_reader_nids": { "$ref": "#/definitions/nids" },
              "radicle_access_removed": { "$ref": "#/definitions/nids" },
              "retire_previous_state": { "const": true },
              "scrub_profile": { "const": "comms-encrypted-branch-cooperative-v1" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "issuer-authority" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "writer_nid", "action"],
            "properties": {
              "claim_id": { "$ref": "#/definitions/sha256" },
              "writer_nid": { "$ref": "#/definitions/nid" },
              "action": { "enum": ["grant", "remove"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "issuance-reservation" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["jti", "writer_nid", "source_claim_ids", "allocation_ref"],
            "properties": {
              "jti": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
              "writer_nid": { "$ref": "#/definitions/nid" },
              "source_claim_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true,
                "items": { "$ref": "#/definitions/sha256" }
              },
              "allocation_ref": { "type": "string", "pattern": "^pending:[A-Za-z0-9._:-]{1,256}$" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "status-invalidation" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["jti", "source_claim_id", "evidence"],
            "properties": {
              "jti": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
              "source_claim_id": { "$ref": "#/definitions/sha256" },
              "evidence": { "$ref": "#/definitions/reduction_evidence" }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nid": { "type": "string", "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$", "maxLength": 128 },
    "nids": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/nid" }
    },
    "json_safe_integer": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
    ,
    "reduction_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "event_id", "authority", "validated_at", "core_kel_authority_valid", "evidence_digest"],
      "properties": {
        "claim_id": { "$ref": "#/definitions/sha256" },
        "event_id": { "$ref": "#/definitions/sha256" },
        "authority": { "enum": ["claim-revocation", "claim-ledger-reader", "oidc-token-issuer", "source-claim"] },
        "validated_at": { "$ref": "#/definitions/json_safe_integer" },
        "core_kel_authority_valid": { "const": true },
        "evidence_digest": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}
