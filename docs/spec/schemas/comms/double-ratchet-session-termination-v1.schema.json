{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/double-ratchet-session-termination-v1.schema.json",
  "title": "Heterodyne Double Ratchet session termination v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "persona",
    "transition_id",
    "old_session_id",
    "local_nid",
    "remote_persona",
    "remote_nid",
    "local_delivery_pubkey",
    "local_delivery_delegation_event_id",
    "remote_delivery_pubkey",
    "remote_delivery_delegation_event_id",
    "source_assignment_digests",
    "removed_holder_nids",
    "retained_holder_nids",
    "invalidated_at",
    "successor_session_ids",
    "nid_revocation_digests",
    "retained_receipts",
    "peer_tombstone",
    "peer_delivery_event",
    "authority",
    "signature"
  ],
  "properties": {
    "type": { "const": "heterodyne.double-ratchet-session-termination.v1" },
    "persona": { "$ref": "#/definitions/hex64" },
    "transition_id": { "$ref": "#/definitions/hex32" },
    "old_session_id": { "$ref": "#/definitions/hex64" },
    "local_nid": { "$ref": "#/definitions/canonical_nid" },
    "remote_persona": { "$ref": "#/definitions/hex64" },
    "remote_nid": { "$ref": "#/definitions/canonical_nid" },
    "local_delivery_pubkey": { "$ref": "#/definitions/hex64" },
    "local_delivery_delegation_event_id": { "$ref": "#/definitions/hex64" },
    "remote_delivery_pubkey": { "$ref": "#/definitions/hex64" },
    "remote_delivery_delegation_event_id": { "$ref": "#/definitions/hex64" },
    "source_assignment_digests": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/hex64" }
    },
    "removed_holder_nids": { "$ref": "#/definitions/nid_array" },
    "retained_holder_nids": { "$ref": "#/definitions/nid_array" },
    "invalidated_at": { "$ref": "#/definitions/json_safe_integer" },
    "successor_session_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/hex64" }
    },
    "nid_revocation_digests": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/hex64" }
    },
    "retained_receipts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/retained_receipt" }
    },
    "peer_tombstone": { "$ref": "#/definitions/peer_tombstone" },
    "peer_delivery_event": { "$ref": "#/definitions/gift_wrap_carrier" },
    "authority": { "$ref": "#/definitions/authority" },
    "signature": { "$ref": "#/definitions/hex128" }
  },
  "definitions": {
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hex128": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "base64url_64_bytes": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    },
    "json_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "canonical_nid": {
      "type": "string",
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "nid_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/canonical_nid" }
    },
    "kel_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "seq"],
      "properties": {
        "event_id": { "$ref": "#/definitions/hex64" },
        "seq": { "$ref": "#/definitions/json_safe_integer" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer_type", "signer", "kel_head"],
      "properties": {
        "signer_type": { "enum": ["epoch", "cold-root"] },
        "signer": { "$ref": "#/definitions/hex64" },
        "kel_head": { "$ref": "#/definitions/kel_head" }
      }
    },
    "retained_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["termination_base_digest", "nid", "observed_at", "signature"],
      "properties": {
        "termination_base_digest": { "$ref": "#/definitions/hex64" },
        "nid": { "$ref": "#/definitions/canonical_nid" },
        "observed_at": { "$ref": "#/definitions/json_safe_integer" },
        "signature": { "$ref": "#/definitions/base64url_64_bytes" }
      }
    },
    "peer_tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "spec_version",
        "persona",
        "transition_id",
        "old_session_id",
        "local_nid",
        "remote_persona",
        "remote_nid",
        "local_delivery_pubkey",
        "local_delivery_delegation_event_id",
        "remote_delivery_pubkey",
        "remote_delivery_delegation_event_id",
        "invalidated_at",
        "successor_session_ids",
        "reason",
        "epoch_pubkey",
        "kel_head",
        "epoch_signature"
      ],
      "properties": {
        "type": { "const": "heterodyne.double-ratchet-peer-tombstone.v1" },
        "spec_version": { "const": "comms/0.5.0" },
        "persona": { "$ref": "#/definitions/hex64" },
        "transition_id": { "$ref": "#/definitions/hex32" },
        "old_session_id": { "$ref": "#/definitions/hex64" },
        "local_nid": { "$ref": "#/definitions/canonical_nid" },
        "remote_persona": { "$ref": "#/definitions/hex64" },
        "remote_nid": { "$ref": "#/definitions/canonical_nid" },
        "local_delivery_pubkey": { "$ref": "#/definitions/hex64" },
        "local_delivery_delegation_event_id": { "$ref": "#/definitions/hex64" },
        "remote_delivery_pubkey": { "$ref": "#/definitions/hex64" },
        "remote_delivery_delegation_event_id": { "$ref": "#/definitions/hex64" },
        "invalidated_at": { "$ref": "#/definitions/json_safe_integer" },
        "successor_session_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/hex64" }
        },
        "reason": {
          "enum": ["persona_node_removed", "candidate_material_retired"]
        },
        "epoch_pubkey": { "$ref": "#/definitions/hex64" },
        "kel_head": { "$ref": "#/definitions/kel_head" },
        "epoch_signature": { "$ref": "#/definitions/hex128" }
      }
    },
    "p_tag": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false,
      "items": [
        { "const": "p" },
        { "$ref": "#/definitions/hex64" }
      ]
    },
    "heterodyne_tag": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false,
      "items": [
        { "const": "heterodyne" },
        { "const": "dr_peer_tombstone" }
      ]
    },
    "gift_wrap_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pubkey", "created_at", "kind", "tags", "content", "sig"],
      "properties": {
        "id": { "$ref": "#/definitions/hex64" },
        "pubkey": { "$ref": "#/definitions/hex64" },
        "created_at": { "$ref": "#/definitions/json_safe_integer" },
        "kind": { "const": 1059 },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "additionalItems": false,
          "items": [
            { "$ref": "#/definitions/p_tag" }
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "sig": { "$ref": "#/definitions/hex128" }
      }
    },
    "seal_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pubkey", "created_at", "kind", "tags", "content", "sig"],
      "properties": {
        "id": { "$ref": "#/definitions/hex64" },
        "pubkey": { "$ref": "#/definitions/hex64" },
        "created_at": { "$ref": "#/definitions/json_safe_integer" },
        "kind": { "const": 13 },
        "tags": {
          "type": "array",
          "maxItems": 0
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "sig": { "$ref": "#/definitions/hex128" }
      }
    },
    "rumor_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pubkey", "created_at", "kind", "tags", "content"],
      "properties": {
        "id": { "$ref": "#/definitions/hex64" },
        "pubkey": { "$ref": "#/definitions/hex64" },
        "created_at": { "$ref": "#/definitions/json_safe_integer" },
        "kind": { "const": 1061 },
        "tags": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "additionalItems": false,
          "items": [
            { "$ref": "#/definitions/p_tag" },
            { "$ref": "#/definitions/heterodyne_tag" }
          ]
        },
        "content": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "seal_carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "nip01_raw"],
      "properties": {
        "event": { "$ref": "#/definitions/seal_event" },
        "nip01_raw": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rumor_carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "nip01_raw"],
      "properties": {
        "event": { "$ref": "#/definitions/rumor_event" },
        "nip01_raw": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gift_wrap_carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "nip01_raw", "seal", "rumor"],
      "properties": {
        "event": { "$ref": "#/definitions/gift_wrap_event" },
        "nip01_raw": {
          "type": "string",
          "minLength": 1
        },
        "seal": { "$ref": "#/definitions/seal_carrier" },
        "rumor": { "$ref": "#/definitions/rumor_carrier" }
      }
    }
  }
}
