{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/credential-ledger-candidate-abandonment-v1.schema.json",
  "title": "Heterodyne Comms credential ledger candidate abandonment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "persona",
    "predecessor_checkpoint",
    "candidate_checkpoint_digest",
    "candidate_transition_id",
    "candidate_transition_digest",
    "candidate_ref",
    "candidate_head",
    "abandonment_ref",
    "abandonment_basis_head",
    "partial_acceptance_record_set_sha256",
    "candidate_exposure_records",
    "candidate_governed_decrypt_key_bindings_sha256",
    "candidate_historical_decrypt_obligations_sha256",
    "abandoned_at",
    "epoch_pubkey",
    "kel_head",
    "epoch_signature"
  ],
  "properties": {
    "type": {
      "const": "heterodyne.credential-ledger.candidate-abandonment.v1"
    },
    "persona": {
      "$ref": "#/definitions/sha256"
    },
    "predecessor_checkpoint": {
      "$ref": "#/definitions/sha256"
    },
    "candidate_checkpoint_digest": {
      "$ref": "#/definitions/sha256"
    },
    "candidate_transition_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/id_16"
        }
      ]
    },
    "candidate_transition_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/sha256"
        }
      ]
    },
    "candidate_ref": {
      "$ref": "#/definitions/config_ref"
    },
    "candidate_head": {
      "$ref": "#/definitions/typed_git_object"
    },
    "abandonment_ref": {
      "$ref": "#/definitions/config_ref"
    },
    "abandonment_basis_head": {
      "$ref": "#/definitions/typed_git_object"
    },
    "partial_acceptance_record_set_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "candidate_exposure_records": {
      "type": "array",
      "maxItems": 65535,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/candidate_exposure"
      }
    },
    "candidate_governed_decrypt_key_bindings_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "candidate_historical_decrypt_obligations_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "abandoned_at": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "epoch_pubkey": {
      "$ref": "#/definitions/sha256"
    },
    "kel_head": {
      "$ref": "#/definitions/kel_head"
    },
    "epoch_signature": {
      "$ref": "#/definitions/bip340_signature"
    }
  },
  "oneOf": [
    {
      "properties": {
        "candidate_transition_id": {
          "type": "null"
        },
        "candidate_transition_digest": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "candidate_transition_id": {
          "$ref": "#/definitions/id_16"
        },
        "candidate_transition_digest": {
          "$ref": "#/definitions/sha256"
        }
      }
    }
  ],
  "definitions": {
    "id_16": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bip340_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "json_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "config_ref": {
      "type": "string",
      "pattern": "^refs/heads/enc/[0-9a-f]{32}$"
    },
    "git_sha1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_format",
        "oid"
      ],
      "properties": {
        "object_format": {
          "const": "sha1"
        },
        "oid": {
          "$ref": "#/definitions/sha1"
        }
      }
    },
    "git_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_format",
        "oid"
      ],
      "properties": {
        "object_format": {
          "const": "sha256"
        },
        "oid": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "typed_git_object": {
      "oneOf": [
        {
          "$ref": "#/definitions/git_sha1"
        },
        {
          "$ref": "#/definitions/git_sha256"
        }
      ]
    },
    "kel_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "seq"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/definitions/sha256"
        },
        "seq": {
          "$ref": "#/definitions/json_safe_integer"
        }
      }
    },
    "candidate_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_digest"
      ],
      "properties": {
        "record_type": {
          "enum": [
            "secret-source",
            "secret-assignment"
          ]
        },
        "record_digest": {
          "$ref": "#/definitions/sha256"
        }
      }
    }
  }
}
