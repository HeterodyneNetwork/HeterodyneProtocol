{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/one-time-invite-response-v1.schema.json",
  "title": "Heterodyne one-time invite response rumor content v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "purpose", "descriptor_digest", "responder_account", "mls_key_package", "requested_class", "capabilities", "proof"],
  "properties": {
    "spec_version": {"const": "heterodyne/0.6.0"},
    "purpose": {"enum": ["dm", "control-enrollment", "device-enrollment"]},
    "descriptor_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "responder_account": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mls_key_package": {"type": "string", "pattern": "^[A-Za-z0-9_-]+={0,2}$"},
    "requested_class": {"enum": ["conversation-peer", "human-light", "automated", "light-device", "full-device", "recovery-device"]},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "proof": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"purpose": {"const": "dm"}}},
      "then": {"properties": {"requested_class": {"const": "conversation-peer"}}}
    },
    {
      "if": {"properties": {"purpose": {"const": "control-enrollment"}}},
      "then": {"properties": {"requested_class": {"enum": ["human-light", "automated"]}}}
    },
    {
      "if": {"properties": {"purpose": {"const": "device-enrollment"}}},
      "then": {"properties": {"requested_class": {"enum": ["light-device", "full-device", "recovery-device"]}}}
    }
  ]
}
