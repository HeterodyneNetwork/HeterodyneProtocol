{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/credential-ledger-emergency-reset-v1.schema.json",
  "title": "Heterodyne Comms credential ledger emergency reset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "reset_id",
    "persona",
    "prior_generation",
    "new_generation",
    "last_common_checkpoint",
    "old_roster",
    "new_roster",
    "unavailable_nodes",
    "prior_config_key_id",
    "new_config_key_id",
    "new_config_key_sha256",
    "prior_pairwise_secret_sha256",
    "new_pairwise_secret_sha256",
    "lost_audit_set_digest",
    "same_key_candidate_audit",
    "offline_recovery_pre_unseal_intents",
    "offline_recovery_pre_unseal_intent_collisions",
    "offline_recovery_activations",
    "offline_recovery_activation_collisions",
    "exposure_set_sha256",
    "governed_decrypt_key_bindings_sha256",
    "historical_decrypt_obligations_sha256",
    "secret_transition_digest",
    "epoch_rotation_event_id",
    "new_epoch_pubkey",
    "new_kel_head",
    "compromise_since",
    "bootstrap_recipients_digest",
    "created_at",
    "reason",
    "cold_root_signature"
  ],
  "properties": {
    "type": {
      "const": "heterodyne.credential-ledger.emergency-reset.v1"
    },
    "reset_id": {
      "$ref": "#/definitions/id_16"
    },
    "persona": {
      "$ref": "#/definitions/sha256"
    },
    "prior_generation": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "new_generation": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "last_common_checkpoint": {
      "$ref": "#/definitions/sha256"
    },
    "old_roster": {
      "allOf": [
        {
          "$ref": "#/definitions/nid_set"
        },
        {
          "minItems": 1
        }
      ]
    },
    "new_roster": {
      "allOf": [
        {
          "$ref": "#/definitions/nid_set"
        },
        {
          "minItems": 1
        }
      ]
    },
    "unavailable_nodes": {
      "$ref": "#/definitions/nid_set"
    },
    "prior_config_key_id": {
      "$ref": "#/definitions/id_16"
    },
    "new_config_key_id": {
      "$ref": "#/definitions/id_16"
    },
    "new_config_key_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "prior_pairwise_secret_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "new_pairwise_secret_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "lost_audit_set_digest": {
      "$ref": "#/definitions/sha256"
    },
    "same_key_candidate_audit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/same_key_candidate_audit"
        }
      ]
    },
    "offline_recovery_pre_unseal_intents": {
      "type": "array",
      "maxItems": 65535,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/offline_intent"
      }
    },
    "offline_recovery_pre_unseal_intent_collisions": {
      "type": "array",
      "maxItems": 65535,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/offline_intent_collision"
      }
    },
    "offline_recovery_activations": {
      "type": "array",
      "maxItems": 65535,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/offline_activation"
      }
    },
    "offline_recovery_activation_collisions": {
      "type": "array",
      "maxItems": 65535,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/offline_activation_collision"
      }
    },
    "exposure_set_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "governed_decrypt_key_bindings_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "historical_decrypt_obligations_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "secret_transition_digest": {
      "$ref": "#/definitions/sha256"
    },
    "epoch_rotation_event_id": {
      "$ref": "#/definitions/sha256"
    },
    "new_epoch_pubkey": {
      "$ref": "#/definitions/sha256"
    },
    "new_kel_head": {
      "$ref": "#/definitions/kel_head"
    },
    "compromise_since": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "bootstrap_recipients_digest": {
      "$ref": "#/definitions/sha256"
    },
    "created_at": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "reason": {
      "enum": [
        "credential_ledger_reset_node_loss",
        "credential_ledger_reset_offline_activation_id_collision"
      ]
    },
    "cold_root_signature": {
      "$ref": "#/definitions/bip340_signature"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reason": {
            "const": "credential_ledger_reset_node_loss"
          }
        },
        "required": [
          "reason"
        ]
      },
      "then": {
        "properties": {
          "unavailable_nodes": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "unavailable_nodes": {
            "maxItems": 0
          }
        },
        "anyOf": [
          {
            "properties": {
              "offline_recovery_pre_unseal_intent_collisions": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "offline_recovery_activation_collisions": {
                "minItems": 1
              }
            }
          }
        ]
      }
    }
  ],
  "definitions": {
    "id_16": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_oid": {
      "oneOf": [
        {
          "$ref": "#/definitions/sha1"
        },
        {
          "$ref": "#/definitions/sha256"
        }
      ]
    },
    "bip340_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "json_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nid": {
      "type": "string",
      "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]+$",
      "maxLength": 128
    },
    "nid_set": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/nid"
      }
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*//)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "git_sha1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_format",
        "oid"
      ],
      "properties": {
        "object_format": {
          "const": "sha1"
        },
        "oid": {
          "$ref": "#/definitions/sha1"
        }
      }
    },
    "git_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_format",
        "oid"
      ],
      "properties": {
        "object_format": {
          "const": "sha256"
        },
        "oid": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "typed_git_object": {
      "oneOf": [
        {
          "$ref": "#/definitions/git_sha1"
        },
        {
          "$ref": "#/definitions/git_sha256"
        }
      ]
    },
    "kel_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "seq"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/definitions/sha256"
        },
        "seq": {
          "$ref": "#/definitions/json_safe_integer"
        }
      }
    },
    "digest_set": {
      "type": "array",
      "maxItems": 1000000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/sha256"
      }
    },
    "candidate_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_digest"
      ],
      "properties": {
        "record_type": {
          "enum": [
            "secret-source",
            "secret-assignment"
          ]
        },
        "record_digest": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "offline_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_id",
        "intent_record_digest",
        "exposure_preimage_set_sha256"
      ],
      "properties": {
        "activation_id": {
          "$ref": "#/definitions/id_16"
        },
        "intent_record_digest": {
          "$ref": "#/definitions/sha256"
        },
        "exposure_preimage_set_sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "offline_intent_collision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_id",
        "intent_record_digests"
      ],
      "properties": {
        "activation_id": {
          "$ref": "#/definitions/id_16"
        },
        "intent_record_digests": {
          "allOf": [
            {
              "$ref": "#/definitions/digest_set"
            },
            {
              "minItems": 2
            }
          ]
        }
      }
    },
    "offline_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_id",
        "activation_record_digest",
        "provisional_exposure_set_sha256"
      ],
      "properties": {
        "activation_id": {
          "$ref": "#/definitions/id_16"
        },
        "activation_record_digest": {
          "$ref": "#/definitions/sha256"
        },
        "provisional_exposure_set_sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "offline_activation_collision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_id",
        "activation_record_digests"
      ],
      "properties": {
        "activation_id": {
          "$ref": "#/definitions/id_16"
        },
        "activation_record_digests": {
          "allOf": [
            {
              "$ref": "#/definitions/digest_set"
            },
            {
              "minItems": 2
            }
          ]
        }
      }
    },
    "opaque_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "object_id",
        "raw_sha256",
        "paths",
        "disposition",
        "audit_path",
        "audit_sha256",
        "inherited_audit_set_digests"
      ],
      "properties": {
        "object_type": {
          "enum": [
            "commit",
            "tree",
            "blob"
          ]
        },
        "object_id": {
          "$ref": "#/definitions/git_oid"
        },
        "raw_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "paths": {
          "type": "array",
          "maxItems": 1000000,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "const": ""
              },
              {
                "$ref": "#/definitions/repository_path"
              }
            ]
          }
        },
        "disposition": {
          "enum": [
            "opaque-copy",
            "inherited-reference"
          ]
        },
        "audit_path": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/repository_path"
            }
          ]
        },
        "audit_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/sha256"
            }
          ]
        },
        "inherited_audit_set_digests": {
          "$ref": "#/definitions/digest_set"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "object_type": {
                "const": "commit"
              }
            },
            "required": [
              "object_type"
            ]
          },
          "then": {
            "properties": {
              "paths": {
                "maxItems": 0
              },
              "disposition": {
                "const": "opaque-copy"
              }
            }
          },
          "else": {
            "properties": {
              "paths": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "inherited-reference"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "audit_path": {
                "type": "null"
              },
              "audit_sha256": {
                "type": "null"
              },
              "inherited_audit_set_digests": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "audit_path": {
                "$ref": "#/definitions/repository_path"
              },
              "audit_sha256": {
                "$ref": "#/definitions/sha256"
              },
              "inherited_audit_set_digests": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "safe_record_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "record_digest",
        "source_path",
        "audit_path",
        "audit_sha256"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/definitions/profile_id"
        },
        "record_digest": {
          "$ref": "#/definitions/sha256"
        },
        "source_path": {
          "$ref": "#/definitions/repository_path"
        },
        "audit_path": {
          "$ref": "#/definitions/repository_path"
        },
        "audit_sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "same_key_candidate_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor_checkpoint",
        "candidate_checkpoint_digest",
        "accepted_basis_head",
        "candidate_head",
        "candidate_exposure_records",
        "candidate_governed_decrypt_key_bindings_sha256",
        "candidate_historical_decrypt_obligations_sha256",
        "opaque_object_manifest",
        "opaque_object_manifest_sha256",
        "safe_record_copies",
        "safe_record_set_sha256"
      ],
      "properties": {
        "predecessor_checkpoint": {
          "$ref": "#/definitions/sha256"
        },
        "candidate_checkpoint_digest": {
          "$ref": "#/definitions/sha256"
        },
        "accepted_basis_head": {
          "$ref": "#/definitions/typed_git_object"
        },
        "candidate_head": {
          "$ref": "#/definitions/typed_git_object"
        },
        "candidate_exposure_records": {
          "type": "array",
          "maxItems": 65535,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/candidate_exposure"
          }
        },
        "candidate_governed_decrypt_key_bindings_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "candidate_historical_decrypt_obligations_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "opaque_object_manifest": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/opaque_object"
          }
        },
        "opaque_object_manifest_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "safe_record_copies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/safe_record_copy"
          }
        },
        "safe_record_set_sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    }
  }
}
