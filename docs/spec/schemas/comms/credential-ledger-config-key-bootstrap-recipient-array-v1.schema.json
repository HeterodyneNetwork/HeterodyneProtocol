{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/credential-ledger-config-key-bootstrap-recipient-array-v1.schema.json",
  "title": "Heterodyne Comms credential ledger config-key bootstrap recipient array v1",
  "type": "array",
  "minItems": 1,
  "maxItems": 256,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "nid",
      "delegation_event_id",
      "recovery_key",
      "nid_proof",
      "enc",
      "ciphertext"
    ],
    "properties": {
      "nid": {
        "$ref": "#/definitions/nid"
      },
      "delegation_event_id": {
        "$ref": "#/definitions/sha256"
      },
      "recovery_key": {
        "$ref": "#/definitions/recovery_key"
      },
      "nid_proof": {
        "$ref": "#/definitions/ed25519_signature"
      },
      "enc": {
        "$ref": "#/definitions/base64url_32_bytes"
      },
      "ciphertext": {
        "$ref": "#/definitions/canonical_base64url"
      }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nid": {
      "type": "string",
      "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]+$",
      "maxLength": 128
    },
    "base64url_32_bytes": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "ed25519_signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    },
    "canonical_base64url": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
    },
    "recovery_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "public_key"
      ],
      "properties": {
        "algorithm": {
          "const": "X25519"
        },
        "public_key": {
          "$ref": "#/definitions/base64url_32_bytes"
        }
      }
    }
  }
}
