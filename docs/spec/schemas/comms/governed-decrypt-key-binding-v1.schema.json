{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/governed-decrypt-key-binding-v1.schema.json",
  "title": "Heterodyne Comms governed decrypt key binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "persona",
    "binding_id",
    "retained_ciphertext",
    "secret_class",
    "secret_id",
    "instance_commitment",
    "issued_at",
    "authority",
    "signature"
  ],
  "properties": {
    "type": {
      "const": "heterodyne.governed-decrypt-key-binding.v1"
    },
    "persona": {
      "$ref": "#/definitions/sha256"
    },
    "binding_id": {
      "$ref": "#/definitions/sha256"
    },
    "retained_ciphertext": {
      "$ref": "#/definitions/retained_ciphertext"
    },
    "secret_class": {
      "$ref": "#/definitions/secret_class"
    },
    "secret_id": {
      "oneOf": [
        {
          "$ref": "#/definitions/id_16"
        },
        {
          "$ref": "#/definitions/sha256"
        }
      ]
    },
    "instance_commitment": {
      "$ref": "#/definitions/sha256"
    },
    "issued_at": {
      "$ref": "#/definitions/json_safe_integer"
    },
    "authority": {
      "$ref": "#/definitions/authority"
    },
    "signature": {
      "$ref": "#/definitions/bip340_signature"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "secret_class": {
            "const": "config-audience"
          }
        },
        "required": [
          "secret_class"
        ]
      },
      "then": {
        "properties": {
          "secret_id": {
            "$ref": "#/definitions/id_16"
          }
        }
      },
      "else": {
        "properties": {
          "secret_id": {
            "$ref": "#/definitions/sha256"
          }
        }
      }
    }
  ],
  "definitions": {
    "id_16": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bip340_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "json_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive_json_safe_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nid": {
      "type": "string",
      "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]+$",
      "maxLength": 128
    },
    "repository_rid": {
      "type": "string",
      "pattern": "^rad:z[1-9A-HJ-NP-Za-km-z]+$",
      "maxLength": 128
    },
    "ref_name": {
      "type": "string",
      "pattern": "^refs/[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9_-])?$",
      "maxLength": 1024
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*//)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "git_sha1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_format",
        "oid"
      ],
      "properties": {
        "object_format": {
          "const": "sha1"
        },
        "oid": {
          "$ref": "#/definitions/sha1"
        }
      }
    },
    "git_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_format",
        "oid"
      ],
      "properties": {
        "object_format": {
          "const": "sha256"
        },
        "oid": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "typed_git_object": {
      "oneOf": [
        {
          "$ref": "#/definitions/git_sha1"
        },
        {
          "$ref": "#/definitions/git_sha256"
        }
      ]
    },
    "kel_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "seq"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/definitions/sha256"
        },
        "seq": {
          "$ref": "#/definitions/json_safe_integer"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signer_type",
        "signer",
        "kel_head"
      ],
      "properties": {
        "signer_type": {
          "enum": [
            "epoch",
            "cold-root"
          ]
        },
        "signer": {
          "$ref": "#/definitions/sha256"
        },
        "kel_head": {
          "$ref": "#/definitions/kel_head"
        }
      }
    },
    "secret_class": {
      "enum": [
        "cold-root",
        "epoch",
        "device-signing",
        "agent-signing",
        "core-protected",
        "config-audience",
        "tier3-audience",
        "claim-ledger-audience",
        "object-dek",
        "double-ratchet",
        "radicle-access",
        "oauth-signing",
        "oauth-pairwise",
        "bearer-credential",
        "ssh-client",
        "ssh-host",
        "recovery-wrap",
        "onion-service-identity",
        "tls-serving"
      ]
    },
    "retained_ciphertext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_class",
        "owner",
        "repository_rid",
        "repository_head",
        "ref_name",
        "path",
        "git_blob_oid",
        "object_id",
        "ciphertext_sha256",
        "ciphertext_length"
      ],
      "properties": {
        "storage_class": {
          "enum": [
            "git-blob",
            "large-object"
          ]
        },
        "owner": {
          "enum": [
            "core",
            "comms",
            "control",
            "social"
          ]
        },
        "repository_rid": {
          "$ref": "#/definitions/repository_rid"
        },
        "repository_head": {
          "$ref": "#/definitions/typed_git_object"
        },
        "ref_name": {
          "$ref": "#/definitions/ref_name"
        },
        "path": {
          "$ref": "#/definitions/repository_path"
        },
        "git_blob_oid": {
          "$ref": "#/definitions/typed_git_object"
        },
        "object_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/sha256"
            }
          ]
        },
        "ciphertext_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "ciphertext_length": {
          "$ref": "#/definitions/positive_json_safe_integer"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "repository_head": {
                  "$ref": "#/definitions/git_sha1"
                },
                "git_blob_oid": {
                  "$ref": "#/definitions/git_sha1"
                }
              }
            },
            {
              "properties": {
                "repository_head": {
                  "$ref": "#/definitions/git_sha256"
                },
                "git_blob_oid": {
                  "$ref": "#/definitions/git_sha256"
                }
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "storage_class": {
                "const": "git-blob"
              }
            },
            "required": [
              "storage_class"
            ]
          },
          "then": {
            "properties": {
              "object_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "object_id": {
                "$ref": "#/definitions/sha256"
              }
            }
          }
        }
      ]
    }
  }
}
