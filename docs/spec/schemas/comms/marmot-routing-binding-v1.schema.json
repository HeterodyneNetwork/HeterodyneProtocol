{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/marmot-routing-binding-v1.schema.json",
  "title": "Heterodyne Marmot routing binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "stable_group_id",
    "generation",
    "h",
    "event_rid",
    "genesis_manifest_sha256",
    "previous_generation",
    "authorized_hosts",
    "interfaces",
    "retention",
    "admin_account",
    "marmot_routing_event_id",
    "signature"
  ],
  "properties": {
    "spec_version": {
      "const": "heterodyne/0.5.0"
    },
    "stable_group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "h": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "event_rid": {
      "type": "string",
      "pattern": "^rad:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "genesis_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_generation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation",
            "h",
            "event_rid",
            "binding_sha256"
          ],
          "properties": {
            "generation": {
              "type": "integer",
              "minimum": 0
            },
            "h": {
              "type": "string",
              "minLength": 1
            },
            "event_rid": {
              "type": "string",
              "pattern": "^rad:z[1-9A-HJ-NP-Za-km-z]+$"
            },
            "binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "authorized_hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "endpoint"
        ],
        "properties": {
          "type": {
            "enum": [
              "radicle",
              "nostr-onion",
              "nostr-clearnet",
              "media-onion",
              "media-clearnet"
            ]
          },
          "endpoint": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retain_until",
        "non_erasure_acknowledged"
      ],
      "properties": {
        "retain_until": {
          "type": "integer",
          "minimum": 0
        },
        "non_erasure_acknowledged": {
          "const": true
        }
      }
    },
    "admin_account": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "marmot_routing_event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  }
}
