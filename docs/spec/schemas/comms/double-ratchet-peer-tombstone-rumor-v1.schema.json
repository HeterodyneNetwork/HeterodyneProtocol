{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/comms/double-ratchet-peer-tombstone-rumor-v1.schema.json",
  "title": "Heterodyne Double Ratchet peer tombstone rumor carrier v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event", "nip01_raw"],
  "properties": {
    "event": { "$ref": "#/definitions/rumor_event" },
    "nip01_raw": {
      "type": "string",
      "minLength": 1
    }
  },
  "definitions": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "json_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "p_tag": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false,
      "items": [
        { "const": "p" },
        { "$ref": "#/definitions/hex64" }
      ]
    },
    "heterodyne_tag": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false,
      "items": [
        { "const": "heterodyne" },
        { "const": "dr_peer_tombstone" }
      ]
    },
    "rumor_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pubkey", "created_at", "kind", "tags", "content"],
      "properties": {
        "id": { "$ref": "#/definitions/hex64" },
        "pubkey": { "$ref": "#/definitions/hex64" },
        "created_at": { "$ref": "#/definitions/json_safe_integer" },
        "kind": { "const": 1061 },
        "tags": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "additionalItems": false,
          "items": [
            { "$ref": "#/definitions/p_tag" },
            { "$ref": "#/definitions/heterodyne_tag" }
          ]
        },
        "content": {
          "type": "string",
          "minLength": 2
        }
      }
    }
  }
}
