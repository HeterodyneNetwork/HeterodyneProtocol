{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heterodyne.network/schemas/control/control-agent-publish-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "token", "sender_proof", "content", "kind", "resource", "feed", "options"],
  "properties": {
    "spec_version": {"const": "heterodyne/0.5.0"},
    "token": {"type": "string", "minLength": 1, "maxLength": 16384},
    "sender_proof": {"type": "string", "minLength": 1, "maxLength": 16384},
    "content": {"type": "string"},
    "kind": {"type": "integer", "minimum": 0, "maximum": 65535},
    "resource": {"type": "string", "minLength": 1, "maxLength": 512},
    "feed": {"type": "string", "minLength": 1, "maxLength": 256},
    "options": {"type": "object"}
  }
}
