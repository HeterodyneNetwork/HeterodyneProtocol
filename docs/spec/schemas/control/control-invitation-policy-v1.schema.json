{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-invitation-policy-v1.schema.json",
  "title": "Heterodyne Control invitation policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "temporary_expires_at", "global_pending_cap", "pending_lifetime_seconds", "welcome_rate_limit", "welcome_burst_limit", "replenishment_rate_limit", "replenishment_burst_limit", "reserved_entitled_slots"],
  "properties": {
    "mode": {"enum": ["off", "temporary", "permanent"]},
    "temporary_expires_at": {"type": ["integer", "null"], "minimum": 1},
    "global_pending_cap": {"type": "integer", "minimum": 1},
    "pending_lifetime_seconds": {"const": 1800},
    "welcome_rate_limit": {"type": "integer", "minimum": 1},
    "welcome_burst_limit": {"type": "integer", "minimum": 1},
    "replenishment_rate_limit": {"type": "integer", "minimum": 1},
    "replenishment_burst_limit": {"type": "integer", "minimum": 1},
    "reserved_entitled_slots": {"type": "integer", "minimum": 1}
  }
}
