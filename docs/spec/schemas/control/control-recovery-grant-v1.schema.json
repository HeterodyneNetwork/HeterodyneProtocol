{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-recovery-grant-v1.schema.json",
  "title": "Heterodyne private Radicle recovery grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "activation_id",
    "prospective_nid",
    "repositories",
    "direction",
    "byte_ceiling",
    "issued_at",
    "expires_at",
    "completion_digest",
    "signer",
    "signature"
  ],
  "properties": {
    "grant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "activation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prospective_nid": {
      "type": "string",
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rid",
          "head"
        ],
        "properties": {
          "rid": {
            "type": "string",
            "minLength": 1
          },
          "head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "direction": {
      "enum": [
        "fetch",
        "push"
      ]
    },
    "byte_ceiling": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "completion_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signer": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  }
}
