{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-capability-set-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "inbound_execution", "cancellation", "tools"],
  "properties": {
    "role": {
      "enum": ["light-client", "full-node"]
    },
    "inbound_execution": {
      "type": "boolean"
    },
    "cancellation": {
      "type": "boolean"
    },
    "tools": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "input_schema", "timeout_ms"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9._:-]{0,126}[a-zA-Z0-9])?$"
          },
          "input_schema": {
            "type": "object"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
          }
        }
      }
    }
  }
}
