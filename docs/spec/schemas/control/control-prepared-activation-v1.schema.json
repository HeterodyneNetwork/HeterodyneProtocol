{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-prepared-activation-v1.schema.json",
  "title": "Heterodyne prepared recovery-node activation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activation_id",
    "registration_digest",
    "persona",
    "target_device",
    "target_nid",
    "public_device_artifact_digest",
    "private_role_digest",
    "recovery_grant_id",
    "expected",
    "epoch_envelope",
    "expires_at",
    "completion_required",
    "signer",
    "signature",
    "state"
  ],
  "properties": {
    "activation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registration_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "persona": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_device": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_nid": {
      "type": "string",
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "public_device_artifact_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "private_role_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recovery_grant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositories",
        "portable_manifest_id",
        "object_digests"
      ],
      "properties": {
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rid",
              "head"
            ],
            "properties": {
              "rid": {
                "type": "string",
                "minLength": 1
              },
              "head": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        "portable_manifest_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "object_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "epoch_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "epk",
        "nonce",
        "ciphertext"
      ],
      "properties": {
        "alg": {
          "const": "HPKE-secp256k1-HKDF-SHA256-AES256GCM"
        },
        "epk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kty",
            "crv",
            "x"
          ],
          "properties": {
            "kty": {
              "const": "EC"
            },
            "crv": {
              "const": "secp256k1"
            },
            "x": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "ciphertext": {
          "type": "string",
          "minLength": 16
        }
      }
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "completion_required": {
      "const": true
    },
    "signer": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "state": {
      "enum": [
        "prepared",
        "cancelled",
        "activated"
      ]
    }
  }
}
