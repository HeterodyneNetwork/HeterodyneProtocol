{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-operation-record-v1.schema.json",
  "title": "Heterodyne signing operation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile", "spec_version", "operation_id", "request_id", "grant_id", "grant_digest",
    "vault_id", "persona_active_key", "nip46_client_pubkey", "signer_audience",
    "selected_signing_pubkey", "key_class", "rpc_request", "event_kind", "value_msats",
    "request_digest", "execution_token", "window_started_at", "attribution_state", "signature_state", "event_id",
    "state", "result_digest", "failure_digest", "commit_evidence", "created_at", "updated_at"
  ],
  "properties": {
    "profile": {"const": "heterodyne.control.signing-operation.v1"},
    "spec_version": {"const": "heterodyne/0.5.0"},
    "operation_id": {"$ref": "#/$defs/hex256"},
    "request_id": {"$ref": "#/$defs/nip46RequestId"},
    "grant_id": {"$ref": "#/$defs/hex256"},
    "grant_digest": {"$ref": "#/$defs/hex256"},
    "vault_id": {"$ref": "#/$defs/hex256"},
    "persona_active_key": {"$ref": "#/$defs/hex256"},
    "nip46_client_pubkey": {"$ref": "#/$defs/hex256"},
    "signer_audience": {"type": "string", "minLength": 1, "maxLength": 512},
    "selected_signing_pubkey": {"$ref": "#/$defs/hex256"},
    "key_class": {"enum": ["persona", "agent"]},
    "rpc_request": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "method", "params"],
      "properties": {
        "id": {"$ref": "#/$defs/nip46RequestId"},
        "method": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "params": {
          "type": "array", "maxItems": 64,
          "items": {"type": "string", "maxLength": 1048576}
        }
      }
    },
    "event_kind": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 65535},
        {"type": "null"}
      ]
    },
    "request_digest": {"$ref": "#/$defs/hex256"},
    "execution_token": {
      "oneOf": [
        {"$ref": "#/$defs/hex256"},
        {"type": "null"}
      ]
    },
    "value_msats": {"$ref": "#/$defs/time"},
    "window_started_at": {"$ref": "#/$defs/time"},
    "attribution_state": {"enum": ["not-applicable", "required", "applied"]},
    "signature_state": {"enum": ["pending", "produced", "indeterminate"]},
    "event_id": {
      "oneOf": [
        {"$ref": "#/$defs/hex256"},
        {"type": "null"}
      ]
    },
    "state": {"enum": ["reserved", "claimed", "executing", "committed", "indeterminate"]},
    "result_digest": {
      "oneOf": [
        {"$ref": "#/$defs/hex256"},
        {"type": "null"}
      ]
    },
    "failure_digest": {
      "oneOf": [
        {"$ref": "#/$defs/hex256"},
        {"type": "null"}
      ]
    },
    "commit_evidence": {
      "oneOf": [
        {"$ref": "#/$defs/transitionEvidence"},
        {"type": "null"}
      ]
    },
    "created_at": {"$ref": "#/$defs/time"},
    "updated_at": {"$ref": "#/$defs/time"}
  },
  "allOf": [
    {
      "if": {"properties": {"signature_state": {"const": "produced"}}, "required": ["signature_state"]},
      "then": {
        "properties": {
          "event_id": {"$ref": "#/$defs/hex256"},
          "attribution_state": {"enum": ["not-applicable", "applied"]}
        }
      },
      "else": {"properties": {"event_id": {"type": "null"}}}
    },
    {
      "if": {"properties": {"state": {"const": "committed"}}, "required": ["state"]},
      "then": {
        "properties": {
          "result_digest": {"$ref": "#/$defs/hex256"},
          "signature_state": {"const": "produced"},
          "event_id": {"$ref": "#/$defs/hex256"},
          "execution_token": {"$ref": "#/$defs/hex256"},
          "failure_digest": {"type": "null"},
          "commit_evidence": {
            "allOf": [
              {"$ref": "#/$defs/transitionEvidence"},
              {"properties": {"prior_state": {"const": "executing"}, "state": {"const": "committed"}}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "reserved"}}, "required": ["state"]},
      "then": {
        "properties": {
          "result_digest": {"type": "null"},
          "signature_state": {"const": "pending"},
          "event_id": {"type": "null"},
          "execution_token": {"type": "null"},
          "failure_digest": {"type": "null"},
          "commit_evidence": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "claimed"}}, "required": ["state"]},
      "then": {
        "properties": {
          "result_digest": {"type": "null"},
          "signature_state": {"const": "pending"},
          "event_id": {"type": "null"},
          "execution_token": {"type": "null"},
          "failure_digest": {"type": "null"},
          "commit_evidence": {
            "allOf": [
              {"$ref": "#/$defs/transitionEvidence"},
              {"properties": {"prior_state": {"const": "reserved"}, "state": {"const": "claimed"}}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "executing"}}, "required": ["state"]},
      "then": {
        "properties": {
          "result_digest": {"type": "null"},
          "failure_digest": {"type": "null"},
          "signature_state": {"const": "pending"},
          "attribution_state": {"enum": ["not-applicable", "applied"]},
          "event_id": {"type": "null"},
          "execution_token": {"$ref": "#/$defs/hex256"},
          "commit_evidence": {
            "allOf": [
              {"$ref": "#/$defs/transitionEvidence"},
              {"properties": {"prior_state": {"const": "claimed"}, "state": {"const": "executing"}}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "indeterminate"}}, "required": ["state"]},
      "then": {
        "properties": {
          "result_digest": {"type": "null"},
          "signature_state": {"const": "indeterminate"},
          "attribution_state": {"enum": ["not-applicable", "applied"]},
          "event_id": {"type": "null"},
          "execution_token": {"$ref": "#/$defs/hex256"},
          "failure_digest": {"$ref": "#/$defs/hex256"},
          "commit_evidence": {
            "allOf": [
              {"$ref": "#/$defs/transitionEvidence"},
              {"properties": {"prior_state": {"const": "executing"}, "state": {"const": "indeterminate"}}}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "hex256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nip46RequestId": {"type": "string", "pattern": "^[ -~]{1,128}$"},
    "time": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "transitionEvidence": {
      "type": "object", "additionalProperties": false,
      "required": [
        "expected_revision", "next_revision", "prior_state", "state", "persisted_at"
      ],
      "properties": {
        "expected_revision": {"$ref": "#/$defs/time"},
        "next_revision": {"$ref": "#/$defs/time"},
        "prior_state": {"enum": ["reserved", "claimed", "executing"]},
        "state": {"enum": ["claimed", "executing", "committed", "indeterminate"]},
        "persisted_at": {"$ref": "#/$defs/time"}
      }
    }
  }
}
