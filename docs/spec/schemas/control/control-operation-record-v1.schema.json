{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-operation-record-v1.schema.json",
  "title": "Heterodyne Control operation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "persona",
    "client_key",
    "node_key",
    "group_id",
    "request_id",
    "operation_id",
    "profile",
    "method",
    "object",
    "request_digest",
    "state",
    "created_at",
    "updated_at",
    "result_digest",
    "commit_evidence"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "persona": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "client_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "node_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "group_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ]
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "profile": {
      "enum": [
        "human-jsonrpc",
        "agent-mcp"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "id"
      ],
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string"
        }
      }
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "reserved",
        "committed",
        "indeterminate"
      ]
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "result_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "commit_evidence": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
