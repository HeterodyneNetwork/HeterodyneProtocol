{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-enrollment-token-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token_class",
    "token_id",
    "persona",
    "epoch_key",
    "minting_device",
    "kel_head",
    "issued_at",
    "expires_at",
    "grant",
    "signature"
  ],
  "properties": {
    "token_class": {
      "const": "control-enrollment"
    },
    "token_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "persona": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "epoch_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "minting_device": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kel_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "sequence"],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "grant": {
      "$ref": "https://heterodyne.network/schemas/control/control-grant-v1.schema.json"
    },
    "expected_enrollee_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  }
}
