{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-audit-record-v1.schema.json",
  "title": "Heterodyne signer decision audit record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile", "spec_version", "grant_id", "vault_id", "persona_active_key",
    "nip46_client_pubkey", "signer_audience", "selected_signing_pubkey",
    "key_class", "request_id", "method", "event_kind", "payload_digest",
    "attribution_state", "decision", "reason_code", "event_id", "created_at"
  ],
  "properties": {
    "profile": {"const": "heterodyne.control.audit-record.v1"},
    "spec_version": {"const": "heterodyne/0.5.0"},
    "grant_id": {"$ref": "#/$defs/hex256"},
    "vault_id": {"$ref": "#/$defs/hex256"},
    "persona_active_key": {"$ref": "#/$defs/hex256"},
    "nip46_client_pubkey": {"$ref": "#/$defs/hex256"},
    "signer_audience": {"type": "string", "minLength": 1, "maxLength": 512},
    "selected_signing_pubkey": {"$ref": "#/$defs/hex256"},
    "key_class": {"enum": ["persona", "agent"]},
    "request_id": {"$ref": "#/$defs/hex256"},
    "method": {"type": "string", "minLength": 1, "maxLength": 64},
    "event_kind": {"type": "integer", "minimum": 0, "maximum": 65535},
    "payload_digest": {"$ref": "#/$defs/hex256"},
    "attribution_state": {"enum": ["not-applicable", "required", "applied"]},
    "decision": {"enum": ["accept", "reject"]},
    "reason_code": {"type": ["string", "null"], "maxLength": 128},
    "event_id": {
      "oneOf": [
        {"$ref": "#/$defs/hex256"},
        {"type": "null"}
      ]
    },
    "created_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  },
  "$defs": {
    "hex256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
