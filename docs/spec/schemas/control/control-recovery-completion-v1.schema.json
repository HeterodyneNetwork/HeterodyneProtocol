{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-recovery-completion-v1.schema.json",
  "title": "Heterodyne recovery completion proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activation_id",
    "grant_id",
    "portable_manifest_id",
    "repository_heads",
    "object_digests",
    "completed_at",
    "prover_nid",
    "signature"
  ],
  "properties": {
    "activation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "portable_manifest_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_heads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rid",
          "head"
        ],
        "properties": {
          "rid": {
            "type": "string",
            "minLength": 1
          },
          "head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "object_digests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "completed_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "prover_nid": {
      "type": "string",
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "signature": {
      "type": "string",
      "minLength": 16
    }
  }
}
