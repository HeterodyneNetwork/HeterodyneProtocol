{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-client-authorization-v1.schema.json",
  "title": "Heterodyne exact NIP-46 signer grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "spec_version",
    "grant_id",
    "vault_id",
    "persona_active_key",
    "nip46_client_pubkey",
    "signer_audience",
    "selected_signing_pubkey",
    "key_class",
    "persona_signing_authorized",
    "allowed_methods",
    "allowed_event_kinds",
    "limits",
    "oidc_authorization_id",
    "connection_secret_sha256",
    "issued_at",
    "expires_at",
    "predecessor",
    "state",
    "revoked_at",
    "authorizing_pubkey",
    "signature"
  ],
  "properties": {
    "profile": {"const": "heterodyne.control.signer-grant.v1"},
    "spec_version": {"const": "heterodyne/0.5.0"},
    "grant_id": {"$ref": "#/$defs/hex256"},
    "vault_id": {"$ref": "#/$defs/hex256"},
    "persona_active_key": {"$ref": "#/$defs/hex256"},
    "nip46_client_pubkey": {"$ref": "#/$defs/hex256"},
    "signer_audience": {"type": "string", "minLength": 1, "maxLength": 512},
    "selected_signing_pubkey": {"$ref": "#/$defs/hex256"},
    "key_class": {"enum": ["persona", "agent"]},
    "persona_signing_authorized": {"type": "boolean"},
    "allowed_methods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
    },
    "allowed_event_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 65535}
    },
    "limits": {"$ref": "#/$defs/limits"},
    "oidc_authorization_id": {"$ref": "#/$defs/hex256"},
    "connection_secret_sha256": {"$ref": "#/$defs/hex256"},
    "automation_policy": {"$ref": "#/$defs/automationPolicy"},
    "issued_at": {"$ref": "#/$defs/time"},
    "expires_at": {"$ref": "#/$defs/time"},
    "predecessor": {
      "oneOf": [
        {"$ref": "#/$defs/hex256"},
        {"type": "null"}
      ]
    },
    "state": {"enum": ["active", "revoked"]},
    "revoked_at": {
      "oneOf": [
        {"$ref": "#/$defs/time"},
        {"type": "null"}
      ]
    },
    "authorizing_pubkey": {"$ref": "#/$defs/hex256"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"key_class": {"const": "persona"}}, "required": ["key_class"]},
      "then": {"properties": {"persona_signing_authorized": {"const": true}}},
      "else": {"properties": {"persona_signing_authorized": {"const": false}}}
    },
    {
      "if": {"properties": {"state": {"const": "active"}}, "required": ["state"]},
      "then": {"properties": {"revoked_at": {"type": "null"}}},
      "else": {"properties": {"revoked_at": {"$ref": "#/$defs/time"}}}
    }
  ],
  "$defs": {
    "hex256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "finitePositive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "finiteNonNegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_window_seconds", "request_count", "max_event_bytes", "max_value_msats"],
      "properties": {
        "request_window_seconds": {"$ref": "#/$defs/finitePositive"},
        "request_count": {"$ref": "#/$defs/finitePositive"},
        "max_event_bytes": {"$ref": "#/$defs/finitePositive"},
        "max_value_msats": {"$ref": "#/$defs/finiteNonNegative"}
      }
    },
    "agentAssociation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "key"},
            "value": {"$ref": "#/$defs/hex256"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "role"},
            "value": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        }
      ]
    },
    "automationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_id", "agent_class", "agent_association", "tier", "oidc_scopes"],
      "properties": {
        "workload_id": {"$ref": "#/$defs/hex256"},
        "agent_class": {"enum": ["ai", "programmatic"]},
        "agent_association": {"$ref": "#/$defs/agentAssociation"},
        "tier": {"enum": [1, 2, 3]},
        "oidc_scopes": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    }
  }
}
