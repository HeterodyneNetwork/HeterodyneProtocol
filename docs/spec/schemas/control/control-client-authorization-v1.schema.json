{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-client-authorization-v1.schema.json",
  "title": "Heterodyne private Control client authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "persona",
    "client_key",
    "client_class",
    "approving_node",
    "approving_authority",
    "methods",
    "objects",
    "limits",
    "capabilities",
    "token_lifetime_default_seconds",
    "token_lifetime_max_seconds",
    "inbound_execution",
    "predecessor",
    "state",
    "created_at",
    "expires_at",
    "signer",
    "signature"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "persona": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "client_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "client_class": {
      "enum": [
        "human-light",
        "automated"
      ]
    },
    "approving_node": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approving_authority": {
      "type": "string",
      "minLength": 1
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "objects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "id"
        ],
        "properties": {
          "class": {
            "enum": [
              "none",
              "session",
              "repository",
              "config_namespace",
              "marmot_group",
              "feed",
              "media",
              "device"
            ]
          },
          "id": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_content_bytes",
        "rate_window_seconds",
        "rate_count",
        "burst",
        "max_media_bytes"
      ],
      "properties": {
        "max_content_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rate_window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rate_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "burst": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_media_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "control.token.extended",
          "control.inbound-execution",
          "control.approve"
        ]
      }
    },
    "token_lifetime_default_seconds": {
      "const": 300
    },
    "token_lifetime_max_seconds": {
      "type": "integer",
      "minimum": 300,
      "maximum": 3600
    },
    "inbound_execution": {
      "type": "boolean"
    },
    "agent_role": {
      "type": "string",
      "pattern": "^agent:[A-Za-z0-9._-]{1,128}$"
    },
    "predecessor": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "active",
        "revoked"
      ]
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "signer": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "client_class": {
            "const": "automated"
          }
        },
        "required": [
          "client_class"
        ]
      },
      "then": {
        "required": [
          "agent_role"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "client_class": {
            "const": "human-light"
          }
        },
        "required": [
          "client_class"
        ]
      },
      "then": {
        "not": {
          "required": [
            "agent_role"
          ]
        }
      }
    }
  ]
}
