{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-rpc-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "method", "params", "expires_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "method": {"type": "string", "minLength": 1, "maxLength": 128},
    "params": {"type": "object"},
    "expires_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
