{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heterodyne.network/schemas/control/control-agent-token-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "session_id", "request_id", "challenge", "workload_proof", "requested_scopes", "requested_resource", "requested_expiry"],
  "properties": {
    "spec_version": {"const": "control/0.5.0"},
    "session_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "challenge": {"type": "string", "minLength": 16, "maxLength": 512},
    "workload_proof": {"type": "string", "minLength": 1, "maxLength": 16384},
    "requested_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "requested_resource": {"type": "string", "minLength": 1, "maxLength": 512},
    "requested_expiry": {"type": "integer", "minimum": 1}
  }
}
