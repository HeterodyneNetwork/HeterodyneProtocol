{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-epoch-registration-v1.schema.json",
  "title": "Heterodyne prospective full-node epoch registration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "persona",
    "device_key",
    "radicle_nid",
    "keypackage_ref",
    "recovery_key",
    "ssh_key",
    "tor_client_auth_key",
    "capabilities",
    "nonce",
    "created_at",
    "expires_at",
    "proofs"
  ],
  "properties": {
    "type": {
      "const": "heterodyne.control.epoch-registration.v1"
    },
    "persona": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "device_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "radicle_nid": {
      "type": "string",
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "keypackage_ref": {
      "type": "string",
      "minLength": 1
    },
    "recovery_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kty",
        "crv",
        "x"
      ],
      "properties": {
        "kty": {
          "const": "EC"
        },
        "crv": {
          "const": "secp256k1"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "ssh_key": {
      "type": "string",
      "pattern": "^ssh-(ed25519|ecdsa-[A-Za-z0-9@._+-]+) [A-Za-z0-9+/=]+$"
    },
    "tor_client_auth_key": {
      "type": "string",
      "minLength": 32
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "full-node",
          "recovery-node",
          "control.recovery.radicle.v1",
          "control.recovery.epoch-inbox.v1",
          "control.recovery.sftp.v1"
        ]
      }
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "proofs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "radicle",
        "recovery",
        "ssh",
        "tor"
      ],
      "properties": {
        "device": {
          "type": "string",
          "minLength": 16
        },
        "radicle": {
          "type": "string",
          "minLength": 16
        },
        "recovery": {
          "type": "string",
          "minLength": 16
        },
        "ssh": {
          "type": "string",
          "minLength": 16
        },
        "tor": {
          "type": "string",
          "minLength": 16
        }
      }
    }
  }
}
