{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-mcp-frame-v1.schema.json",
  "definitions": {
    "requestId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "websiteUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["experimental"],
      "properties": {
        "experimental": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "required": ["network.heterodyne.control"],
          "properties": {
            "network.heterodyne.control": {
              "$ref": "https://heterodyne.network/schemas/control/control-capability-set-v1.schema.json"
            }
          }
        }
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "textContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "_meta": {
          "type": "object"
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/definitions/requestId"
        },
        "method": {
          "const": "initialize"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocolVersion",
            "capabilities",
            "clientInfo"
          ],
          "properties": {
            "protocolVersion": {
              "const": "2025-11-25"
            },
            "capabilities": {
              "$ref": "#/definitions/capabilities"
            },
            "clientInfo": {
              "$ref": "#/definitions/implementation"
            },
            "_meta": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/definitions/requestId"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocolVersion",
            "capabilities",
            "serverInfo"
          ],
          "properties": {
            "protocolVersion": {
              "const": "2025-11-25"
            },
            "capabilities": {
              "$ref": "#/definitions/capabilities"
            },
            "serverInfo": {
              "$ref": "#/definitions/implementation"
            },
            "instructions": {
              "type": "string"
            },
            "_meta": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "notifications/initialized"
        },
        "params": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/definitions/requestId"
        },
        "method": {
          "const": "tools/call"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "arguments": {
              "type": "object"
            },
            "_meta": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/definitions/requestId"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content"],
          "properties": {
            "content": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "$ref": "#/definitions/textContent"
              }
            },
            "structuredContent": {
              "type": "object"
            },
            "isError": {
              "type": "boolean"
            },
            "_meta": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "error"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/definitions/requestId"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "data": {}
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "notifications/cancelled"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestId"],
          "properties": {
            "requestId": {
              "$ref": "#/definitions/requestId"
            },
            "reason": {
              "type": "string",
              "maxLength": 1024
            },
            "_meta": {
              "type": "object"
            }
          }
        }
      }
    }
  ]
}
