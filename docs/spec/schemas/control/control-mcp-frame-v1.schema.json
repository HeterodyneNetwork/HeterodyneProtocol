{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-mcp-frame-v1.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "method": {
          "const": "initialize"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilities"],
          "properties": {
            "capabilities": {
              "$ref": "https://heterodyne.network/schemas/control/control-capability-set-v1.schema.json"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content"],
          "properties": {
            "content": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "text"],
                    "properties": {
                      "type": {
                        "const": "text"
                      },
                      "text": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "value"],
                    "properties": {
                      "type": {
                        "const": "json"
                      },
                      "value": {}
                    }
                  }
                ]
              }
            },
            "isError": {
              "type": "boolean"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "data": {}
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilities"],
          "properties": {
            "capabilities": {
              "$ref": "https://heterodyne.network/schemas/control/control-capability-set-v1.schema.json"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "method": {
          "const": "tools/call"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "arguments", "timeout_ms"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "arguments": {
              "type": "object"
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "notifications/cancelled"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_id"],
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    }
  ]
}
