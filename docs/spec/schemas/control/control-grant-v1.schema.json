{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.network/schemas/control/control-grant-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tier",
    "media_upload",
    "repositories",
    "config_namespaces",
    "sessions"
  ],
  "properties": {
    "tier": {
      "enum": ["baseline", "regular", "full"]
    },
    "media_upload": {
      "type": "boolean"
    },
    "repositories": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "config_namespaces": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
      }
    },
    "sessions": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
