  "vector_id": "public-reader/external-media-disclosure",
  "description": "A non-Tor public reader strips credentials and referrer data and warns before an external-media request.",
  "direction": "consume",
  "input": {
    "tor_available": false,
    "external_media": "https://media.example/image.png"
  },
  "expected_output": {
    "verdict": "accept",
    "normalized": {
      "credentials": "omit",
      "referrer": "none",
      "network_address_warning": true
    }
  }
}
