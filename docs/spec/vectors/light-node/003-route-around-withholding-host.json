    "hosts": [
      "wss://withholds.example/relay",
      "wss://serves.example/relay"
    ],
    "withholding_hosts": [
      "wss://withholds.example/relay"
    ],
    "nostr_relay_fallback": [
      "wss://relay.example"
    ]
  },
  "expected_output": {
    "verdict": "accept",
    "normalized": {
      "obtained": true,
      "obtained_from": "wss://serves.example/relay",
      "routed_around": [
        "wss://withholds.example/relay"
      ]
    }
  },
  "decision_trace": [
    "query_routing_node",
    "fetch_primary_host_withheld",
    "retry_alternate_host",
    "obtained",
    "verify_signature_locally"
  ],
  "direction": "consume"
}
