          },
          "dependency_versions": {
            "const": {
              "core": "core/0.5.0",
              "comms": "comms/0.5.0"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "direction": {
            "const": "consume"
          },
          "expected_output": {
            "type": "object",
            "properties": {
              "verdict": {
