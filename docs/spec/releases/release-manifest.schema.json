{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.example/spec/releases/release-manifest.schema.json",
  "title": "Heterodyne document release manifest",
  "$comment": "Checked-in manifests use lexicographically sorted object keys, compact canonical JSON with no insignificant whitespace, and exactly one trailing LF.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "version",
    "qualified_version",
    "registry_revision",
    "registry_sha256",
    "dependencies",
    "provided_features",
    "required_features",
    "conformance_status"
  ],
  "properties": {
    "document": {
      "type": "string",
      "enum": [
        "core",
        "comms",
        "control",
        "social",
        "workspace"
      ]
    },
    "version": {
      "enum": ["0.5.0", "0.1.0"]
    },
    "qualified_version": {
      "type": "string",
      "enum": [
        "core/0.5.0",
        "comms/0.5.0",
        "control/0.5.0",
        "social/0.5.0",
        "workspace/0.1.0"
      ]
    },
    "registry_revision": {
      "const": 8
    },
    "registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "const": "c8bb46583807062d2fc39206bba425bfa848d88fd203bfdda175d474ce1005e1"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "core": {
          "const": "core/0.5.0"
        },
        "comms": {
          "const": "comms/0.5.0"
        },
        "control": {
          "const": "control/0.5.0"
        },
        "social": {
          "const": "social/0.5.0"
        }
      }
    },
    "provided_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conformance_status": {
      "type": "string",
      "enum": [
        "conformant",
        "incomplete-draft"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "document": {
          "const": "core"
        },
        "version": {
          "const": "0.5.0"
        },
        "qualified_version": {
          "const": "core/0.5.0"
        },
        "dependencies": {
          "maxProperties": 0
        },
        "provided_features": {
          "const": [
            "core.nostr-relay-read.v1",
            "core.outbound-tor.v1",
            "core.repo-relay-client.v1",
            "core.onion-service-host.v1",
            "core.browser-shared-relay.v1",
            "core.marmot-role-attribution.v1"
          ]
        },
        "required_features": {
          "const": []
        },
        "conformance_status": {
          "const": "conformant"
        }
      }
    },
    {
      "properties": {
        "document": {
          "const": "comms"
        },
        "version": {
          "const": "0.5.0"
        },
        "qualified_version": {
          "const": "comms/0.5.0"
        },
        "dependencies": {
          "required": [
            "core"
          ],
          "minProperties": 1,
          "maxProperties": 1
        },
        "provided_features": {
          "const": [
            "comms.key-claims.v1",
            "comms.private-claim-ledger.v1",
            "comms.oidc-jwt-projection.v1",
            "comms.token-status-list-draft-21.v1",
            "comms.public-reader.v1",
            "comms.agent-authorship.v1",
            "comms.marmot-conversations.v1",
            "comms.radicle-marmot-storage.v1",
            "comms.radicle-backed-marmot-relay.v1"
          ]
        },
        "required_features": {
          "const": [
            "core.marmot-role-attribution.v1",
            "core.nostr-relay-read.v1",
            "core.repo-relay-client.v1"
          ]
        },
        "conformance_status": {
          "const": "conformant"
        }
      }
    },
    {
      "properties": {
        "document": {
          "const": "control"
        },
        "version": {
          "const": "0.5.0"
        },
        "qualified_version": {
          "const": "control/0.5.0"
        },
        "dependencies": {
          "required": [
            "core",
            "comms"
          ],
          "minProperties": 2,
          "maxProperties": 2
        },
        "provided_features": {
          "const": [
            "control.marmot.v1",
            "control.oauth-device-enrollment.v1",
            "control.private-entitlement.v1",
            "control.node-scoped-token.v1",
            "control.agent-workload-publication.v1",
            "control.node-mediated-marmot.v1",
            "control.recovery.radicle.v1",
            "control.recovery.epoch-inbox.v1",
            "control.recovery.sftp.v1"
          ]
        },
        "required_features": {
          "const": [
            "core.repo-relay-client.v1",
            "comms.agent-authorship.v1",
            "comms.marmot-conversations.v1",
            "comms.oidc-jwt-projection.v1",
            "comms.private-claim-ledger.v1",
            "comms.radicle-marmot-storage.v1"
          ]
        },
        "conformance_status": {
          "const": "conformant"
        }
      }
    },
    {
      "properties": {
        "document": {
          "const": "social"
        },
        "version": {
          "const": "0.5.0"
        },
        "qualified_version": {
          "const": "social/0.5.0"
        },
        "dependencies": {
          "required": [
            "core",
            "comms"
          ],
          "minProperties": 2,
          "maxProperties": 2
        },
        "provided_features": {
          "const": [
            "social.agent-policy-moderation.v1"
          ]
        },
        "required_features": {
          "const": [
            "comms.agent-authorship.v1",
            "comms.marmot-conversations.v1"
          ]
        },
        "conformance_status": {
          "const": "conformant"
        }
      }
    },
    {
      "properties": {
        "document": {
          "const": "workspace"
        },
        "version": {
          "const": "0.1.0"
        },
        "qualified_version": {
          "const": "workspace/0.1.0"
        },
        "dependencies": {
          "required": ["core", "comms", "control", "social"],
          "minProperties": 4,
          "maxProperties": 4
        },
        "provided_features": {
          "const": [
            "workspace.role-authorization.v1",
            "workspace.private-role-control.v1",
            "workspace.radicle-transport-backstop.v1",
            "workspace.resource-key-delivery.v1",
            "workspace.bilateral-allowance.v1",
            "workspace.joint-governance.v1"
          ]
        },
        "required_features": {
          "const": [
            "core.marmot-role-attribution.v1",
            "core.repo-relay-client.v1",
            "comms.marmot-conversations.v1",
            "comms.radicle-marmot-storage.v1",
            "comms.radicle-backed-marmot-relay.v1"
          ]
        },
        "conformance_status": {
          "const": "conformant"
        }
      }
    }
  ]
}
