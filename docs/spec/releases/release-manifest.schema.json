{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heterodyne.example/spec/releases/release-manifest.schema.json",
  "title": "Heterodyne 0.5.0 document release manifest",
  "$comment": "Checked-in manifests use lexicographically sorted object keys, compact canonical JSON with no insignificant whitespace, and exactly one trailing LF.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "version",
    "qualified_version",
    "registry_revision",
    "registry_sha256",
    "dependencies",
    "features",
    "conformance_status"
  ],
  "properties": {
    "document": {
      "type": "string",
      "enum": ["core", "comms", "control", "social"]
    },
    "version": {
      "const": "0.5.0"
    },
    "qualified_version": {
      "type": "string",
      "enum": ["core/0.5.0", "comms/0.5.0", "control/0.5.0", "social/0.5.0"]
    },
    "registry_revision": {
      "const": 3
    },
    "registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "const": "593c5f029c25fd4b3f019f5d332a24e424448aacce7c86ac199909a020ecd4cd"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "core": { "const": "core/0.5.0" },
        "comms": { "const": "comms/0.5.0" }
      }
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "conformance_status": {
      "type": "string",
      "enum": ["conformant", "incomplete-draft"]
    }
  },
  "oneOf": [
    {
      "properties": {
        "document": { "const": "core" },
        "qualified_version": { "const": "core/0.5.0" },
        "dependencies": { "maxProperties": 0 },
        "features": {
          "const": [
            "core.nostr-relay-read.v1",
            "core.outbound-tor.v1",
            "core.repo-relay-client.v1",
            "core.onion-service-host.v1",
            "core.browser-shared-relay.v1"
          ]
        },
        "conformance_status": { "const": "conformant" }
      }
    },
    {
      "properties": {
        "document": { "const": "comms" },
        "qualified_version": { "const": "comms/0.5.0" },
        "dependencies": { "required": ["core"], "minProperties": 1, "maxProperties": 1 },
        "features": {
          "const": [
            "key-claims",
            "private-claim-ledger",
            "oidc-jwt-projection",
            "token-status-list-draft-21",
            "comms.public-reader.v1",
            "comms.agent-authorship.v1"
          ]
        },
        "conformance_status": { "const": "conformant" }
      }
    },
    {
      "properties": {
        "document": { "const": "control" },
        "qualified_version": { "const": "control/0.5.0" },
        "dependencies": { "required": ["core", "comms"], "minProperties": 2, "maxProperties": 2 },
        "features": {
          "const": [
            "double-ratchet",
            "control.relay-affinity.v1",
            "control.agent-workload-publication.v1"
          ]
        },
        "conformance_status": { "const": "incomplete-draft" }
      }
    },
    {
      "properties": {
        "document": { "const": "social" },
        "qualified_version": { "const": "social/0.5.0" },
        "dependencies": { "required": ["core", "comms"], "minProperties": 2, "maxProperties": 2 },
        "features": { "const": ["social.agent-policy-moderation.v1"] },
        "conformance_status": { "const": "conformant" }
      }
    }
  ]
}
