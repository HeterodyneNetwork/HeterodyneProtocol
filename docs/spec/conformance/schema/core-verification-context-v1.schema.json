{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heterodyne.network/schemas/conformance/core-verification-context-v1.schema.json",
  "title": "CoreVerificationContextV1",
  "description": "Non-wire evidence for active-key persona resolution and an optional explicitly requested Assurance claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["active_persona_key"],
  "properties": {
    "active_persona_key": { "$ref": "#/$defs/hex32" },
    "assurance": { "$ref": "#/$defs/assurance" }
  },
  "$defs": {
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "verified"],
      "properties": {
        "requested": { "type": "boolean" },
        "verified": { "type": "boolean" }
      }
    }
  }
}
